  <Property Name="sonar.issue.ignore.multicriteria">razorNullForgiving</Property>
  <Property Name="sonar.issue.ignore.multicriteria.razorNullForgiving.ruleKey">csharpsquid:S8970</Property>
  <Property Name="sonar.issue.ignore.multicriteria.razorNullForgiving.resourceKey">**/*.razor</Property>
</SonarQubeAnalysisProperties>
