@page "/account/login"
@attribute [ExcludeFromInteractiveRouting]
@inject AuthenticationSettings AuthenticationSettings

<PageTitle>Login - Keeptrack</PageTitle>

<div class="kt-login-wrap">
    <div class="kt-login-card">
        <div class="kt-login-logo">Keeptrack</div>
        <p class="kt-login-tagline">Sign in to your collection</p>

        <div id="error-msg" class="alert alert-danger" style="display:none"></div>

        @if (AuthenticationSettings.Mode == AuthenticationMode.Local)
        {
            <LocalSignIn/>
        }
        else
        {
            <FirebaseSignIn/>
        }

        <p style="font-size:0.72rem; color:var(--kt-text-subtle); text-align:center; margin-top:1.5rem; margin-bottom:0; line-height:1.6;">
            New accounts start as a free preview: track your movies and TV shows.
            <br/>By signing in you agree to the terms and conditions.
        </p>
    </div>
</div>
