@inject FirebaseClientSettings FirebaseConfig

@* Rendered once, statically, from App.razor, so this <script> lands in the initial document and runs, since scripts injected by interactive components don't execute.
   Firebase's SDK rotates the ID token roughly hourly, and each fresh token goes to /auth/refresh, so the cookie's stored token stays current and API calls don't answer 401 mid-session.
   Harmless for signed-out visitors, for whom onIdTokenChanged never fires with a user. *@
<script type="module">
    import { initializeApp, getApp, getApps } from 'https://www.gstatic.com/firebasejs/11.6.0/firebase-app.js';
    import { getAuth, onIdTokenChanged } from 'https://www.gstatic.com/firebasejs/11.6.0/firebase-auth.js';

    // Reuses the default app if the login page created it (both run on /account/login).
    // The shared default name lets this listener see the session the sign-in flow persisted, since a differently named app has its own auth persistence.
    const config = {
        apiKey: "@FirebaseConfig.ApiKey",
        authDomain: "@FirebaseConfig.AuthDomain",
        projectId: "@FirebaseConfig.ProjectId"
    };
    const app = getApps().length ? getApp() : initializeApp(config);
    const auth = getAuth(app);

    let lastPushed = null;
    onIdTokenChanged(auth, async (user) => {
        if (!user) return;
        const idToken = await user.getIdToken();
        if (idToken === lastPushed) return;
        lastPushed = idToken;
        try {
            await fetch('/auth/refresh', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ idToken })
            });
        } catch {
            // A network hiccup pushing the refreshed token is non-fatal, and the next onIdTokenChanged retries.
        }
    });
</script>
