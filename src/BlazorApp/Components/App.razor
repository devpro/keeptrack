@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@inject AuthenticationSettings AuthenticationSettings
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader/>
    <script src="@Assets["download.js"]"></script>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["Keeptrack.BlazorApp.styles.css"]"/>
    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>
<Routes @rendermode="RenderModeForPage" />
<ReconnectModal/>
@if (AuthenticationSettings.Mode == AuthenticationMode.Firebase)
{
    <FirebaseSessionRefresh/>
}
@if (Configuration.GetValue("Features:IsWebSocketsOnlyEnabled", true))
{
    @* The circuit runs on a single WebSocket with no negotiate round-trip, so it pins to the server instance that owns its state.
       That is the only way several replicas work behind a plain Kubernetes Service (cloudflared, or any proxy without cookie affinity).
       A reconnect after a network blip opens a fresh WebSocket that may land on another replica, and each retry re-rolls, so with few replicas the odds of never reaching the right one are negligible.
       The flag (default on) exists for a proxy that can't pass WebSockets through, and such a deployment must stay single-replica.
       transport: 1 is HttpTransportType.WebSockets. *@
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        Blazor.start({
            circuit: {
                configureSignalR: builder => builder.withUrl('_blazor', { transport: 1, skipNegotiation: true })
            }
        });
    </script>
}
else
{
    <script src="@Assets["_framework/blazor.web.js"]"></script>
}
</body>

</html>

@code {
    // cascades the HttpContext to avoid static naming context conflicts
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // the framework extension honours [ExcludeFromInteractiveRouting]
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
