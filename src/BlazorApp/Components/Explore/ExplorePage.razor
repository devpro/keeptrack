@page "/explore"
@attribute [Authorize]
@using System.Globalization
@using Keeptrack.BlazorApp.Components.Inventory
@using Keeptrack.BlazorApp.Components.Shared
@using Keeptrack.WebApi.Contracts.Dto

<div class="kt-page-header">
    <h1>Ex<span>plore</span></h1>
    <div class="d-flex gap-2 align-items-center">
        <ListViewToggle View="@_view" ViewChanged="@OnViewChanged"/>
        <button class="btn btn-sm kt-toggle-btn" @onclick="RefreshAsync" disabled="@_loading" title="Refresh suggestions">↻ Refresh</button>
    </div>
</div>

<p class="mb-3" style="color:var(--kt-text-muted)">
    Top-rated @TabLabel.ToLowerInvariant() from @ProviderName you don't track yet. Add one to your
    collection in a tap, or dismiss it to stop it coming back.
</p>

<div class="kt-tabs">
    <button class="kt-tab @(_tab == Tab.Movies ? "active" : "")" @onclick="() => SelectTab(Tab.Movies)">Movies</button>
    <button class="kt-tab @(_tab == Tab.TvShows ? "active" : "")" @onclick="() => SelectTab(Tab.TvShows)">TV shows</button>
    @* Video games are a member-only collection - a free preview account can't add one, so it isn't offered
       one either. Hiding is UX, not security: the API applies the same gate to every Explore request. *@
    <AuthorizeView Policy="MemberOnly">
        <button class="kt-tab @(_tab == Tab.VideoGames ? "active" : "")" @onclick="() => SelectTab(Tab.VideoGames)">Video games</button>
    </AuthorizeView>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading && Current is null)
{
    <div class="kt-loading">
        <div class="kt-spinner"></div>
        Loading…
    </div>
}
else if (Current is { Items.Count: 0 } empty)
{
    <div class="kt-empty">
        <div class="kt-empty-icon">◈</div>
        @* "not built yet" and "you've seen it all" are the same empty list but opposite messages - the server
           distinguishes them so this page doesn't have to tell a fresh deployment it has run out. *@
        @if (empty.CataloguePending)
        {
            <p>@TabLabel.ToUpperInvariant()[..1]@TabLabel[1..] suggestions are still being prepared - check back in a little while.</p>
        }
        else
        {
            <p>No new suggestions right now - you already track the top-rated titles. Try Refresh, or dismiss fewer.</p>
        }
    </div>
}
else if (Current is { } state)
{
    var items = state.Items;
    <div class="kt-table-wrap">
        @if (_view == "grid")
        {
            <div class="kt-item-grid">
                @foreach (var item in items)
                {
                    <ItemGridCard Href="@null" Title="@item.Title" ImageUrl="@item.ImageUrl">
                        <Actions>
                            <div class="kt-explore-actions">
                                @if (_busy.Contains(item.ExternalId))
                                {
                                    <span class="kt-icon-btn" aria-label="Adding"><span class="kt-icon-spin">↻</span></span>
                                }
                                else
                                {
                                    <button type="button" class="kt-icon-btn" title="Add to my collection" aria-label="Add to my collection"
                                            @onclick="() => AddAsync(item)">
                                        <AddToCollectionIcon/>
                                    </button>
                                }
                                <button type="button" class="kt-icon-btn" title="Dismiss" aria-label="Dismiss"
                                        disabled="@_busy.Contains(item.ExternalId)" @onclick="() => DismissAsync(item)">✕</button>
                            </div>
                        </Actions>
                        <MetaContent>
                            @if (item.Year > 0)
                            {
                                <span>@item.Year</span>
                            }
                            @if (item.Rating is not null)
                            {
                                <span class="kt-ref-rating"><span class="kt-ref-rating-star">★</span> @item.Rating.Value.ToString("0.0", CultureInfo.InvariantCulture)</span>
                            }
                        </MetaContent>
                    </ItemGridCard>
                }
            </div>
        }
        else
        {
            <div class="kt-item-list">
                @foreach (var item in items)
                {
                    <div class="kt-item-row">
                        <ItemThumb ImageUrl="@item.ImageUrl" Shape="@null"/>
                        <div class="kt-item-main">
                            <span class="kt-item-title">@item.Title</span>
                            <div class="kt-item-meta">
                                @if (item.Year > 0)
                                {
                                    <span>@item.Year</span>
                                }
                                @if (item.Rating is not null)
                                {
                                    <span class="kt-ref-rating"><span class="kt-ref-rating-star">★</span> @item.Rating.Value.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                }
                            </div>
                        </div>
                        <div class="kt-explore-row-actions">
                            @if (_busy.Contains(item.ExternalId))
                            {
                                <span class="kt-icon-btn" aria-label="Adding"><span class="kt-icon-spin">↻</span></span>
                            }
                            else
                            {
                                <button type="button" class="kt-icon-btn" title="Add to my collection" aria-label="Add to my collection"
                                        @onclick="() => AddAsync(item)">
                                    <AddToCollectionIcon/>
                                </button>
                            }
                            <button type="button" class="kt-icon-btn" title="Dismiss" aria-label="Dismiss"
                                    disabled="@_busy.Contains(item.ExternalId)" @onclick="() => DismissAsync(item)">✕</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @if (state.HasMore)
    {
        <div class="d-flex justify-content-center my-3">
            <button type="button" class="btn kt-toggle-btn" disabled="@_loadingMore" @onclick="LoadMoreAsync">
                @if (_loadingMore)
                {
                    <span class="kt-icon-spin">↻</span>
                    <span>Loading…</span>
                }
                else
                {
                    <span>Load more</span>
                }
            </button>
        </div>
    }
}

@code {
    private enum Tab { Movies, TvShows, VideoGames }

    [Inject] private ExploreApiClient Api { get; set; } = null!;

    [Inject] private NavigationManager Navigation { get; set; } = null!;

    [Inject] private ListViewPreference ViewPreference { get; set; } = null!;

    [Inject] private IAuthorizationService Authorization { get; set; } = null!;

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    // Persisted in the URL (?tab=) like the Wishlist page, so back/forward and a refresh keep the active tab.
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    /// <summary>How many suggestions to request per fetch, and the low-water mark a list is topped up at.</summary>
    private const int PageCount = 24;

    private Tab _tab;
    private string _view = "";
    private bool _loading;
    private bool _loadingMore;
    private bool _isMember;
    private string? _error;

    // one loaded list per tab, so switching back and forth doesn't refetch; the external ids currently being
    // added/dismissed, to swap their button for a spinner and guard against a double click.
    private readonly Dictionary<Tab, TabState> _cache = [];
    private readonly HashSet<string> _busy = [];

    private TabState? Current => _cache.TryGetValue(_tab, out var state) ? state : null;

    /// <summary>
    /// What one tab has loaded so far and where to carry on from. The cursor is the server's, not a page
    /// number: suggestions the caller already tracks are filtered out after the ranking is read, so positions
    /// shift and only the server can say where the next page starts.
    /// </summary>
    private sealed class TabState
    {
        public List<ExploreSuggestionDto> Items { get; } = [];

        public int? NextCursor { get; set; }

        public bool CataloguePending { get; set; }

        public bool HasMore => NextCursor is not null;

        public void Append(ExploreSuggestionPageDto page)
        {
            // the server excludes what's already tracked or dismissed, but a card removed from this list
            // locally (added/dismissed a moment ago) can still be in flight, so dedupe on the client too.
            var have = Items.Select(i => i.ExternalId).ToHashSet();
            Items.AddRange(page.Items.Where(i => have.Add(i.ExternalId)));
            NextCursor = page.NextCursor;
            CataloguePending = page.CataloguePending;
        }
    }

    private string TypeName => _tab switch
    {
        Tab.TvShows => nameof(ReferenceItemType.TvShow),
        Tab.VideoGames => nameof(ReferenceItemType.VideoGame),
        _ => nameof(ReferenceItemType.Movie)
    };

    private string TabLabel => _tab switch
    {
        Tab.TvShows => "TV shows",
        Tab.VideoGames => "video games",
        _ => "movies"
    };

    // Each domain discovers through its own reference provider, so the blurb names the one actually queried.
    private string ProviderName => _tab == Tab.VideoGames ? "RAWG" : "TMDB";

    protected override async Task OnInitializedAsync()
    {
        _view = ViewPreference.View;
        if (AuthenticationState is not null)
        {
            var authState = await AuthenticationState;
            _isMember = (await Authorization.AuthorizeAsync(authState.User, "MemberOnly")).Succeeded;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _tab = Enum.TryParse<Tab>(TabQuery, out var tab) ? tab : Tab.Movies;
        // a free preview account can reach ?tab=VideoGames by hand or from a stale link; land it on the
        // default tab rather than letting the API's own 403 surface as an error banner.
        if (_tab == Tab.VideoGames && !_isMember) _tab = Tab.Movies;
        if (!_cache.ContainsKey(_tab)) await LoadAsync();
    }

    private void OnViewChanged(string view) => _view = view;

    private void SelectTab(Tab tab) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["tab"] = tab.ToString() }));

    private async Task LoadAsync()
    {
        _error = null;
        await LoadingIndicator.RunAsync(FetchAsync(), v => _loading = v, StateHasChanged);
        _loading = false;
    }

    private async Task FetchAsync()
    {
        var state = new TabState();
        state.Append(await Api.GetAsync(TypeName, PageCount));
        _cache[_tab] = state;
    }

    private async Task RefreshAsync()
    {
        _cache.Remove(_tab);
        await LoadAsync();
    }

    /// <summary>
    /// Appends the next page below what's already on screen, never reshuffling it. Explicit rather than
    /// infinite-scrolled: a Blazor Server circuit shouldn't re-render the whole grid on every scroll event.
    /// </summary>
    private async Task LoadMoreAsync()
    {
        if (_loadingMore) return;

        _loadingMore = true;
        try
        {
            await AppendNextPageAsync();
            _error = null;
        }
        catch (Exception)
        {
            _error = "Something went wrong - please try again.";
        }
        finally
        {
            _loadingMore = false;
        }
    }

    // the one place a further page is requested and merged, shared by the explicit "Load more" and the
    // automatic top-up after an add/dismiss.
    private async Task AppendNextPageAsync()
    {
        var state = Current;
        if (state is null || !state.HasMore) return;

        state.Append(await Api.GetAsync(TypeName, PageCount, state.NextCursor));
    }

    private async Task AddAsync(ExploreSuggestionDto item) => await ActAsync(item, () => Api.AddAsync(TypeName, item.ExternalId, item.Title, item.Year));

    private async Task DismissAsync(ExploreSuggestionDto item) => await ActAsync(item, () => Api.DismissAsync(TypeName, item.ExternalId));

    // Add and dismiss share everything but the one call: run it, drop the card, and top the list back up if
    // it's getting short - so the two handlers never duplicate the busy-guard / remove / top-up logic.
    private async Task ActAsync(ExploreSuggestionDto item, Func<Task> action)
    {
        if (!_busy.Add(item.ExternalId)) return;
        try
        {
            await action();
            Current?.Items.Remove(item);
            await TopUpAsync();
            _error = null;
        }
        catch (Exception)
        {
            _error = "Something went wrong - please try again.";
        }
        finally
        {
            _busy.Remove(item.ExternalId);
        }
    }

    // Keep the list topped up after an add/dismiss: pull the *next* page and append it below the current
    // cards, so removing one is promptly backfilled without reshuffling what's on screen. A no-op once the
    // ranking is exhausted.
    //
    // This used to re-request the first page and diff it, which meant every single add and dismiss re-paid
    // for the same top-of-the-list suggestions and could only ever backfill from titles the user had already
    // been shown. Continuing from the cursor asks for what actually comes next, and costs one indexed read.
    private async Task TopUpAsync()
    {
        if (Current is { Items.Count: < PageCount }) await AppendNextPageAsync();
    }
}
