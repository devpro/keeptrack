@page "/explore"
@attribute [Authorize]
@using System.Globalization
@using Keeptrack.BlazorApp.Components.Inventory
@using Keeptrack.BlazorApp.Components.Shared
@using Keeptrack.WebApi.Contracts.Dto

<div class="kt-page-header">
    <h1>Ex<span>plore</span></h1>
    <div class="d-flex gap-2 align-items-center">
        <ListViewToggle View="@_view" ViewChanged="@OnViewChanged"/>
        <button class="btn btn-sm kt-toggle-btn" @onclick="RefreshAsync" disabled="@_loading" title="Refresh suggestions"><Icon Name="refresh" Size="13"/> Refresh</button>
    </div>
</div>

@* The discovery provider is a deployment-time choice, so the blurb doesn't name it, and each card names its own link's destination. *@
<p class="mb-3" style="color:var(--kt-text-muted)">
    Top-rated @TabLabel.ToLowerInvariant() you don't track yet. Open one to read more, add it to your
    collection in a tap, or dismiss it to stop it coming back.
</p>

<div class="kt-tabs">
    <button class="kt-tab @(_tab == Tab.Movies ? "active" : "")" @onclick="() => SelectTab(Tab.Movies)">Movies</button>
    <button class="kt-tab @(_tab == Tab.TvShows ? "active" : "")" @onclick="() => SelectTab(Tab.TvShows)">TV shows</button>
    @* Video games are a member-only collection, so a free preview account isn't offered one.
       Hiding is UX, not security, since the API applies the same gate to every Explore request. *@
    <AuthorizeView Policy="MemberOnly">
        <button class="kt-tab @(_tab == Tab.VideoGames ? "active" : "")" @onclick="() => SelectTab(Tab.VideoGames)">Video games</button>
    </AuthorizeView>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading && Current is null)
{
    <div class="kt-loading">
        <div class="kt-spinner"></div>
        Loading…
    </div>
}
else if (Current is { Items.Count: 0 } empty)
{
    <div class="kt-empty">
        <div class="kt-empty-icon"><Icon Name="empty" Size="40" StrokeWidth="1.1"/></div>
        @* "Not built yet" and "everything seen" are the same empty list with opposite messages, and the server tells them apart so a fresh deployment isn't told it has run out. *@
        @if (empty.CataloguePending)
        {
            <p>@TabLabel.ToUpperInvariant()[..1]@TabLabel[1..] suggestions are still being prepared - check back in a little while.</p>
        }
        else
        {
            <p>No new suggestions right now - you already track the top-rated titles. Try Refresh, or dismiss fewer.</p>
        }
    </div>
}
else if (Current is { } state)
{
    var items = state.Items;
    <div class="kt-table-wrap">
        @if (_view == "grid")
        {
            <div class="kt-item-grid">
                @foreach (var item in items)
                {
                    @* The card opens the title's provider page in a new tab, since a suggestion has no detail page yet, and reading up on it shouldn't lose the list being worked through. *@
                    <ItemGridCard Href="@item.ProviderUrl" Target="_blank" LinkLabel="@LinkLabel(item)"
                                  Title="@item.Title" ImageUrl="@item.ImageUrl">
                        <Actions>
                            <div class="kt-explore-actions">
                                @if (_busy.Contains(item.ExternalId))
                                {
                                    <span class="kt-icon-btn" aria-label="Adding"><span class="kt-icon-spin"><Icon Name="refresh" Size="15"/></span></span>
                                }
                                else
                                {
                                    <button type="button" class="kt-icon-btn" title="Add to my collection" aria-label="Add to my collection"
                                            @onclick="() => AddAsync(item)">
                                        <Icon Name="add-to-collection" Size="17"/>
                                    </button>
                                }
                                <button type="button" class="kt-icon-btn" title="Dismiss" aria-label="Dismiss"
                                        disabled="@_busy.Contains(item.ExternalId)" @onclick="() => DismissAsync(item)">✕</button>
                            </div>
                        </Actions>
                        <MetaContent>
                            @if (item.Year > 0)
                            {
                                <span>@item.Year</span>
                            }
                            @if (item.Rating is not null)
                            {
                                <span class="kt-ref-rating"><span class="kt-ref-rating-star">★</span> @item.Rating.Value.ToString("0.0", CultureInfo.InvariantCulture)</span>
                            }
                            @if (item.ProviderUrl is not null)
                            {
                                @* Names the destination, since a card that silently leaves the app is worse than one that says where it goes. *@
                                <span class="kt-explore-source"><Icon Name="external-link" Size="11"/> @item.ProviderName</span>
                            }
                        </MetaContent>
                    </ItemGridCard>
                }
            </div>
        }
        else
        {
            <div class="kt-item-list">
                @foreach (var item in items)
                {
                    <div class="kt-item-row">
                        <ItemThumb ImageUrl="@item.ImageUrl" Title="@item.Title" Shape="@null"/>
                        <div class="kt-item-main">
                            @* Like the grid card, the whole row opens the provider page in a new tab (the stretched link), with the action buttons above it by z-index.
                               A suggestion with no stored link is plain text rather than a dead anchor. *@
                            @if (item.ProviderUrl is not null)
                            {
                                <a class="kt-item-title stretched-link" href="@item.ProviderUrl" target="_blank"
                                   rel="noopener noreferrer" aria-label="@LinkLabel(item)">@item.Title</a>
                            }
                            else
                            {
                                <span class="kt-item-title">@item.Title</span>
                            }
                            <div class="kt-item-meta">
                                @if (item.Year > 0)
                                {
                                    <span>@item.Year</span>
                                }
                                @if (item.Rating is not null)
                                {
                                    <span class="kt-ref-rating"><span class="kt-ref-rating-star">★</span> @item.Rating.Value.ToString("0.0", CultureInfo.InvariantCulture)</span>
                                }
                                @if (item.ProviderUrl is not null)
                                {
                                    <span class="kt-explore-source"><Icon Name="external-link" Size="11"/> @item.ProviderName</span>
                                }
                            </div>
                        </div>
                        <div class="kt-explore-row-actions">
                            @if (_busy.Contains(item.ExternalId))
                            {
                                <span class="kt-icon-btn" aria-label="Adding"><span class="kt-icon-spin"><Icon Name="refresh" Size="15"/></span></span>
                            }
                            else
                            {
                                <button type="button" class="kt-icon-btn" title="Add to my collection" aria-label="Add to my collection"
                                        @onclick="() => AddAsync(item)">
                                    <Icon Name="add-to-collection" Size="17"/>
                                </button>
                            }
                            <button type="button" class="kt-icon-btn" title="Dismiss" aria-label="Dismiss"
                                    disabled="@_busy.Contains(item.ExternalId)" @onclick="() => DismissAsync(item)">✕</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @if (state.HasMore)
    {
        <div class="d-flex justify-content-center my-3">
            <button type="button" class="btn kt-toggle-btn" disabled="@_loadingMore" @onclick="LoadMoreAsync">
                @if (_loadingMore)
                {
                    <span class="kt-icon-spin"><Icon Name="refresh" Size="15"/></span>
                    <span>Loading…</span>
                }
                else
                {
                    <span>Load more</span>
                }
            </button>
        </div>
    }
}

@code {
    private enum Tab { Movies, TvShows, VideoGames }

    [Inject] private ExploreApiClient Api { get; set; } = null!;

    [Inject] private NavigationManager Navigation { get; set; } = null!;

    [Inject] private ListViewPreference ViewPreference { get; set; } = null!;

    [Inject] private IAuthorizationService Authorization { get; set; } = null!;

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    // Persisted in the URL (?tab=) like the Wishlist page, so back, forward and a refresh keep the active tab.
    [SupplyParameterFromQuery(Name = "tab")]
    public string? TabQuery { get; set; }

    /// <summary>How many suggestions to request per fetch, and the low-water mark a list is topped up at.</summary>
    private const int PageCount = 24;

    private Tab _tab;
    private string _view = "";
    private bool _loading;
    private bool _loadingMore;
    private bool _isMember;
    private string? _error;

    // One loaded list per tab, so switching back and forth doesn't refetch.
    // The external ids being added or dismissed swap their button for a spinner and guard against a double click.
    private readonly Dictionary<Tab, TabState> _cache = [];
    private readonly HashSet<string> _busy = [];

    private TabState? Current => _cache.TryGetValue(_tab, out var state) ? state : null;

    /// <summary>
    /// What one tab has loaded so far and where to carry on from.
    /// The cursor is the server's, not a page number: tracked suggestions are filtered out after the ranking is read, so positions shift and only the server knows where the next page starts.
    /// </summary>
    private sealed class TabState
    {
        public List<ExploreSuggestionDto> Items { get; } = [];

        public int? NextCursor { get; set; }

        public bool CataloguePending { get; set; }

        public bool HasMore => NextCursor is not null;

        public void Append(ExploreSuggestionPageDto page)
        {
            // The server excludes what's tracked or dismissed, but a card just added or dismissed can still be in flight, so the client dedupes too.
            var have = Items.Select(i => i.ExternalId).ToHashSet();
            Items.AddRange(page.Items.Where(i => have.Add(i.ExternalId)));
            NextCursor = page.NextCursor;
            CataloguePending = page.CataloguePending;
        }
    }

    private string TypeName => _tab switch
    {
        Tab.TvShows => nameof(ReferenceItemType.TvShow),
        Tab.VideoGames => nameof(ReferenceItemType.VideoGame),
        _ => nameof(ReferenceItemType.Movie)
    };

    private string TabLabel => _tab switch
    {
        Tab.TvShows => "TV shows",
        Tab.VideoGames => "video games",
        _ => "movies"
    };

    // Where a card's link goes, spelled out for screen readers, since the visible cue is the provider name in the meta line, which the title doesn't repeat.
    private static string LinkLabel(ExploreSuggestionDto item) => $"{item.Title} on {item.ProviderName}";

    protected override async Task OnInitializedAsync()
    {
        _view = ViewPreference.View;
        if (AuthenticationState is not null)
        {
            var authState = await AuthenticationState;
            _isMember = (await Authorization.AuthorizeAsync(authState.User, "MemberOnly")).Succeeded;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _tab = Enum.TryParse<Tab>(TabQuery, out var tab) ? tab : Tab.Movies;
        // A free preview account can reach ?tab=VideoGames by hand or from a stale link.
        // It lands on the default tab rather than seeing the API's 403 as an error banner.
        if (_tab == Tab.VideoGames && !_isMember) _tab = Tab.Movies;
        if (!_cache.ContainsKey(_tab)) await LoadAsync();
    }

    private void OnViewChanged(string view) => _view = view;

    private void SelectTab(Tab tab) =>
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["tab"] = tab.ToString() }));

    private async Task LoadAsync()
    {
        _error = null;
        await LoadingIndicator.RunAsync(FetchAsync(), v => _loading = v, StateHasChanged);
        _loading = false;
    }

    private async Task FetchAsync()
    {
        var state = new TabState();
        state.Append(await Api.GetAsync(TypeName, PageCount));
        _cache[_tab] = state;
    }

    private async Task RefreshAsync()
    {
        _cache.Remove(_tab);
        await LoadAsync();
    }

    /// <summary>
    /// Appends the next page below what's already on screen, never reshuffling it.
    /// Explicit rather than infinite scroll, since a Blazor Server circuit shouldn't re-render the whole grid on every scroll event.
    /// </summary>
    private async Task LoadMoreAsync()
    {
        if (_loadingMore) return;

        _loadingMore = true;
        try
        {
            await AppendNextPageAsync();
            _error = null;
        }
        catch (Exception)
        {
            _error = "Something went wrong - please try again.";
        }
        finally
        {
            _loadingMore = false;
        }
    }

    // the one place a further page is requested and merged, shared by "Load more" and the top-up after an add or dismiss
    private async Task AppendNextPageAsync()
    {
        var state = Current;
        if (state is null || !state.HasMore) return;

        state.Append(await Api.GetAsync(TypeName, PageCount, state.NextCursor));
    }

    private async Task AddAsync(ExploreSuggestionDto item) => await ActAsync(item, () => Api.AddAsync(TypeName, item.ExternalId, item.Title, item.Year));

    private async Task DismissAsync(ExploreSuggestionDto item) => await ActAsync(item, () => Api.DismissAsync(TypeName, item.ExternalId));

    // Add and dismiss share everything but the call: run it, drop the card, and top the list up if it's getting short.
    private async Task ActAsync(ExploreSuggestionDto item, Func<Task> action)
    {
        if (!_busy.Add(item.ExternalId)) return;
        try
        {
            await action();
            Current?.Items.Remove(item);
            await TopUpAsync();
            _error = null;
        }
        catch (Exception)
        {
            _error = "Something went wrong - please try again.";
        }
        finally
        {
            _busy.Remove(item.ExternalId);
        }
    }

    // Keeps the list topped up after an add or dismiss by appending the next page below the current cards, without reshuffling what's on screen.
    // Continuing from the cursor asks for what comes next, in one indexed read, and is a no-op once the ranking is exhausted.
    private async Task TopUpAsync()
    {
        if (Current is { Items.Count: < PageCount }) await AppendNextPageAsync();
    }
}
