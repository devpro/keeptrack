@* The TV show list row's second line. Shared by the owner list page and the shared-collection view. *@

@if (Item.Year > 0)
{
    <span>@Item.Year</span>
}
@if (Item.State is not null)
{
    <span class="kt-status-badge @Item.State.ToString()!.ToLowerInvariant()">@Item.State</span>
}
@if (Item.Rating is not null)
{
    <span class="kt-stars"><StarRating Rating="Item.Rating"/></span>
}
@if (Item.IsFavorite)
{
    <span class="kt-flag-badge favorite">Favorite</span>
}
@if (Item.OwnedVersions.Count > 0)
{
    <span class="kt-flag-badge">Owned</span>
}
@if (Item.IsWishlisted)
{
    <span class="kt-flag-badge wishlist">Wishlist</span>
}

@code {
    [Parameter] public required TvShowDto Item { get; set; }
}
