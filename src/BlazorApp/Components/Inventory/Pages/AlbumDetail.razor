@page "/albums/{Id}"
@attribute [Authorize]
@inherits ReferenceLinkedDetailPageBase<AlbumDto, AlbumReferenceDto>
@using Keeptrack.BlazorApp.Components.ReferenceData
@using Keeptrack.BlazorApp.Components.ReferenceDataAdmin

@if (!IsLoaded)
{
    @if (IsLoading)
    {
        <div class="kt-loading">
            <div class="kt-spinner"></div>
            Loading…
        </div>
    }
}
else if (Album is null)
{
    <div class="kt-empty">
        <div class="kt-empty-icon"><Icon Name="empty" Size="40" StrokeWidth="1.1"/></div>
        <p>Album not found.</p>
    </div>
}
else
{
    <Breadcrumb ListRoute="/albums" ListLabel="Albums" Current="@Album.Title"/>

    <div class="kt-page-header">
        <div class="kt-title-row">
            <input class="kt-title-input" value="@Album.Title" @onchange="SaveTitleAsync"/>
            <ReferenceMatchControls TDto="AlbumDto" Api="Api" ItemId="@(Album.Id!)" ReferenceId="@Album.ReferenceId" ReferenceTitle="@Reference?.Title"
                                    ReferenceDataDescription="cover, tracklist, artist"
                                    OnChecked="OnReferenceCheckedAsync" OnUnlinked="LoadAsync"/>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm kt-toggle-btn @(Album.IsFavorite ? "active" : "")" @onclick="ToggleFavoriteAsync">Favorites</button>
        </div>
    </div>
    @if (ShowLinker)
    {
        <AuthorizeView Policy="AdminOnly">
            <Authorized>
                <InlineReferenceLinker Type="ReferenceItemType.Album" Title="@Album.Title" Year="Album.Year" Creator="@Album.Artist" OnLinked="LoadAsync"/>
            </Authorized>
        </AuthorizeView>
    }

    <div class="kt-form-card">
        @{ var coverUrl = !string.IsNullOrEmpty(Album.CustomImageUrl) ? Album.CustomImageUrl : Reference?.ImageUrl; }
        <DetailHero ImageUrl="@coverUrl" Shape="square" Alt="@($"{Album.Title} cover")">
            <div class="col-12">
                <label class="form-label">Artist</label>
                <input class="form-control form-control-sm" data-testid="artist-input" value="@Album.Artist" @onchange="SaveArtistAsync"/>
            </div>
            <div class="col-4">
                <label class="form-label">Year</label>
                <input class="form-control form-control-sm" type="number" min="1900" max="2100"
                       value="@Album.Year" @onchange="SaveYearAsync"/>
            </div>
            <div class="col-8">
                <label class="form-label">Genre</label>
                <input class="form-control form-control-sm" value="@Album.Genre" @onchange="SaveGenreAsync"/>
            </div>
            <div class="col-12">
                <label class="form-label">Rating</label>
                <StarRatingInput Rating="Album.Rating" RatingChanged="SetRatingAsync"/>
            </div>
            @if (Reference?.Ratings.Count > 0)
            {
                <div class="col-12">
                    <label class="form-label">Reference rating</label>
                    <ReferenceRatings Ratings="Reference.Ratings"/>
                </div>
            }
            <div class="col-12">
                <label class="form-label">Cover image URL</label>
                <input class="form-control form-control-sm" placeholder="@(Reference?.ImageUrl is null ? "" : "Leave blank to use the linked reference's cover")"
                       value="@Album.CustomImageUrl" @onchange="SaveCustomImageUrlAsync"/>
            </div>
        </DetailHero>
    </div>

    @if (Reference?.Tracks.Count > 0)
    {
        <h2 class="kt-section-title">Tracklist</h2>
        <div class="kt-form-card">
            @foreach (var track in Reference.Tracks)
            {
                <div class="d-flex justify-content-between align-items-center py-1 position-relative">
                    <span><span class="kt-card-meta" style="display:inline-block;width:2.5rem">@track.Position</span> @track.Title</span>
                    <div class="d-flex align-items-center gap-2">
                        <span class="kt-card-meta">@track.Duration</span>
                        <button class="kt-icon-btn" title="More options" @onclick="() => ToggleTrackMenu(track.Position)">⋮</button>
                    </div>
                    @if (_openTrackMenu == track.Position)
                    {
                        <div class="kt-menu">
                            <p class="kt-card-meta mb-1">Add to playlist</p>
                            @if (Playlists is null or { Count: 0 })
                            {
                                <p class="kt-card-meta mb-0"><a href="/playlists">Create a playlist first</a></p>
                            }
                            else
                            {
                                @foreach (var playlist in Playlists)
                                {
                                    <button class="kt-menu-item" @onclick="() => AddTrackToPlaylistAsync(track, playlist)">@playlist.Title</button>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }

    <OwnedVersionsEditor Versions="Album.OwnedVersions" OnChanged="SaveAsync"/>

    @if (!string.IsNullOrEmpty(Reference?.ArtistImageUrl))
    {
        <h2 class="kt-section-title">Artist</h2>
        <CastGrid Cast="@_artistCard"/>
    }
}

@code {
    [Inject] private AlbumApiClient AlbumApi { get; set; } = null!;

    [Inject] private ReferenceDataApiClient ReferenceDataApi { get; set; } = null!;

    [Inject] private PlaylistApiClient PlaylistApi { get; set; } = null!;

    [Inject] private SongApiClient SongApi { get; set; } = null!;

    protected override InventoryApiClientBase<AlbumDto> Api => AlbumApi;

    protected override AlbumDto? Item { get => Album; set => Album = value; }

    protected override AlbumReferenceDto? ItemReference { get => Reference; set => Reference = value; }

    protected override Task<AlbumReferenceDto?> GetReferenceAsync(string referenceId) => ReferenceDataApi.GetAlbumAsync(referenceId);

    protected override async Task LoadExtrasAsync()
    {
        var playlists = await PlaylistApi.GetAsync("", 1, 5000);
        Playlists = playlists.Items;
    }

    // Public, as [PersistentState] requires: the prerendered item carries over to the interactive circuit instead of being fetched again.
    [PersistentState]
    public AlbumDto? Album { get; set; }

    [PersistentState]
    public AlbumReferenceDto? Reference { get; set; }

    // Nullable, to tell "not loaded yet" from "loaded, no playlists".
    [PersistentState]
    public List<PlaylistDto>? Playlists { get; set; }

    private string? _openTrackMenu;

    /// <summary>Reuses <c>CastGrid</c>'s photo and name card for the single credited artist, which looks the same as a cast member.</summary>
    private List<CastMemberDto> _artistCard => Reference is null
        ? []
        : [new CastMemberDto { Name = Reference.ArtistName ?? Album?.Artist ?? "", CharacterName = "", ProfileImageUrl = Reference.ArtistImageUrl }];

    private void ToggleTrackMenu(string position)
    {
        _openTrackMenu = _openTrackMenu == position ? null : position;
    }

    /// <summary>
    /// The shared "add a real track" operation (<see cref="SongApiClient.GetOrCreateForTrackAsync"/>) -
    /// reuses the same <see cref="SongDto"/> if this exact track was already added to any playlist,
    /// instead of creating a duplicate.
    /// </summary>
    private async Task AddTrackToPlaylistAsync(ReferenceTrackDto track, PlaylistDto playlist)
    {
        _openTrackMenu = null;
        if (Album?.Id is null) return;

        var song = await SongApi.GetOrCreateForTrackAsync(Album.Id, track.Position, track.Title, track.Duration, Album.Artist);
        if (song.Id is not null && !playlist.SongIds.Contains(song.Id))
        {
            playlist.SongIds.Add(song.Id);
            await PlaylistApi.UpdateAsync(playlist);
        }
    }

    private async Task SetRatingAsync(float rating)
    {
        if (Album is null) return;
        Album.Rating = rating;
        await SaveAsync();
    }

    private async Task ToggleFavoriteAsync()
    {
        if (Album is null) return;
        Album.IsFavorite = !Album.IsFavorite;
        await SaveAsync();
    }

    private async Task SaveTitleAsync(ChangeEventArgs e)
    {
        if (Album is null) return;
        var title = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(title)) return;
        Album.Title = title;
        await SaveAsync();
    }

    private async Task SaveArtistAsync(ChangeEventArgs e)
    {
        if (Album is null) return;
        Album.Artist = e.Value?.ToString();
        await SaveAsync();
    }

    private async Task SaveGenreAsync(ChangeEventArgs e)
    {
        if (Album is null) return;
        Album.Genre = e.Value?.ToString();
        await SaveAsync();
    }

    private async Task SaveCustomImageUrlAsync(ChangeEventArgs e)
    {
        if (Album is null) return;
        Album.CustomImageUrl = e.Value?.ToString();
        await SaveAsync();
    }

    private async Task SaveYearAsync(ChangeEventArgs e)
    {
        if (Album is null) return;
        Album.Year = int.TryParse(e.Value?.ToString(), out var year) ? year : null;
        await SaveAsync();
    }
}
