@page "/cars/{Id}"
@attribute [Authorize]
@inherits JournalDetailPageBase<CarDto, CarHistoryDto, CarMetricsDto>

@if (!IsLoaded)
{
    @if (IsLoading)
    {
        <div class="kt-loading">
            <div class="kt-spinner"></div>
            Loading…
        </div>
    }
}
else if (Car is null)
{
    <div class="kt-empty">
        <div class="kt-empty-icon"><Icon Name="empty" Size="40" StrokeWidth="1.1"/></div>
        <p>Car not found.</p>
    </div>
}
else
{
    @if (CanEdit)
    {
        <Breadcrumb ListRoute="/cars" ListLabel="Cars" Current="@Car.Name"/>
    }
    else
    {
        <Breadcrumb ParentRoute="/account/manage/shared-with-me" ParentLabel="Shared with me"
                    ListRoute="@($"/account/manage/shared/{ShareId}")" ListLabel="@(OwnerName ?? "Shared collection")" Current="@Car.Name"/>
    }

    <div class="kt-page-header">
        <div class="kt-title-row">
            <input class="kt-title-input" value="@Car.Name" @onchange="SaveNameAsync" disabled="@(!CanEdit)"/>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Car.ImageUrl))
    {
        <div class="kt-form-card p-0 mb-3" style="overflow:hidden">
            <img src="@Car.ImageUrl" alt="@Car.Name cover" style="width:100%;max-height:320px;object-fit:cover;display:block"/>
        </div>
    }

    <div class="kt-form-card">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Manufacturer</label>
                <input class="form-control form-control-sm" value="@Car.Manufacturer" @onchange="SaveManufacturerAsync" disabled="@(!CanEdit)"/>
            </div>
            <div class="col-md-3">
                <label class="form-label">Model</label>
                <input class="form-control form-control-sm" value="@Car.Model" @onchange="SaveModelAsync" disabled="@(!CanEdit)"/>
            </div>
            <div class="col-md-2">
                <label class="form-label">Year</label>
                <input class="form-control form-control-sm" type="number" min="1900" max="2100" value="@Car.Year" @onchange="SaveYearAsync" disabled="@(!CanEdit)"/>
            </div>
            <div class="col-md-4">
                <label class="form-label">License plate</label>
                <input class="form-control form-control-sm" value="@Car.LicensePlate" @onchange="SaveLicensePlateAsync" disabled="@(!CanEdit)"/>
            </div>
        </div>
        <div class="mt-3">
            <label class="form-label d-block">Energy type</label>
            <div class="d-flex gap-2">
                @foreach (var energyType in Enum.GetValues<CarEnergyType>())
                {
                    <button class="btn btn-sm @(Car.EnergyType == energyType ? "btn-primary" : "btn-secondary")"
                            @onclick="() => SetEnergyTypeAsync(energyType)" disabled="@(!CanEdit)">@energyType</button>
                }
            </div>
        </div>
        @if (CanEdit)
        {
            <div class="mt-3">
                <label class="form-label">Cover image URL</label>
                <input class="form-control form-control-sm" data-testid="image-url-input" value="@Car.ImageUrl" @onchange="SaveImageUrlAsync"/>
            </div>
        }
    </div>

    @if (HasMetricsToShow)
    {
        var metrics = Metrics!;
        <h2 class="kt-section-title">Metrics</h2>
        <div class="kt-form-card kt-car-metrics">
            @if (metrics.MileageWarnings.Count > 0)
            {
                <p class="kt-callout kt-callout-warning">
                    ⚠ @metrics.MileageWarnings.Count mileage inconsistenc@(metrics.MileageWarnings.Count == 1 ? "y" : "ies") found - check the highlighted row(s) below.
                </p>
            }

            @{
                var showFuelChart = ShowFuel && metrics.FuelConsumption.Count > 0;
                var showElectricChart = ShowElectric && metrics.ElectricConsumption.Count > 0;
                // Side-by-side (half width each) only when both charts actually render, e.g. a hybrid -
                // a combustion-only or electric-only car has just one chart, which should take the full row
                // instead of leaving the other half empty.
                var bothConsumptionCharts = showFuelChart && showElectricChart;
                var consumptionColClass = bothConsumptionCharts ? "col-md-6" : "col-12";
                var consumptionGeometry = bothConsumptionCharts ? SvgChartHelpers.HalfWidthGeometry : SvgChartHelpers.FullWidthGeometry;
            }
            <div class="row g-4">
                @if (showFuelChart)
                {
                    <div class="@consumptionColClass">
                        <p class="kt-card-meta mb-1">
                            Fuel consumption (L/100km) - avg @metrics.AverageFuelConsumptionPer100Km?.ToString("F1")
                        </p>
                        <ConsumptionChart Points="metrics.FuelConsumption" Color="var(--kt-accent)" YAxisLabel="L/100km" ChartId="fuel" Geometry="consumptionGeometry"/>
                    </div>
                }
                @if (showElectricChart)
                {
                    <div class="@consumptionColClass">
                        <p class="kt-card-meta mb-1">
                            Electric consumption (kWh/100km) - avg @metrics.AverageElectricConsumptionPer100Km?.ToString("F1")
                        </p>
                        <ConsumptionChart Points="metrics.ElectricConsumption" Color="var(--kt-chart-secondary)" YAxisLabel="kWh/100km" ChartId="electric" Geometry="consumptionGeometry"/>
                    </div>
                }
            </div>

            @if (metrics.CostHistory.Count > 0)
            {
                <p class="kt-card-meta mt-4 mb-1">Cost history - total @metrics.TotalCost.ToString("F2")</p>
                <div class="kt-chart-legend">
                    <span><span class="kt-legend-swatch" style="background:var(--kt-accent)"></span> Fuel</span>
                    <span><span class="kt-legend-swatch" style="background:var(--kt-chart-secondary)"></span> Maintenance</span>
                </div>
                <CarCostHistoryChart Points="metrics.CostHistory"/>
            }
        </div>
    }

    @if (Metrics is { LastRecords.Count: > 0 })
    {
        <h2 class="kt-section-title">Last record</h2>
        <div class="kt-form-card">
            @foreach (var record in Metrics.LastRecords)
            {
                <div class="d-flex justify-content-between" style="max-width:420px">
                    <span>@record.EventType</span>
                    <span class="kt-card-meta">@record.LastDate.ToString("yyyy-MM-dd")</span>
                </div>
            }
        </div>
    }

    <div class="d-flex justify-content-between align-items-center">
        <h2 class="kt-section-title">History</h2>
        @if (CanEdit)
        {
            <button class="btn btn-sm btn-primary" @onclick="ShowAddModal">+ Add entry</button>
        }
    </div>
    @* kt-table-grid opts this table out of the mobile stacked-cards treatment (see HealthProfileDetail.razor's
       journal for the same pattern) - a real spreadsheet-like grid with only the most important columns
       (City/Description) stay desktop-only via d-none d-md-table-cell.
       One tab per year (same kt-season-picker/kt-page-btn header as TvShowDetail.razor's season tabs and
       HealthProfileDetail.razor's journal), newest year first. *@
    @if (History!.Count == 0)
    {
        <div class="kt-table-wrap kt-car-sheet">
            <div class="table-responsive">
                <table class="table kt-sheet-table kt-table-grid">
                    <tbody>
                    <tr><td class="text-center kt-card-meta">@(CanEdit ? "No history yet - add the first entry above." : "No history recorded.")</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="kt-season-picker">
            @foreach (var year in Years)
            {
                <button class="kt-page-btn @(year == SelectedYear ? "active" : "")" @onclick="() => SelectYear(year)">@year</button>
            }
        </div>
        <div class="kt-table-wrap kt-car-sheet">
            <div class="table-responsive">
                <table class="table kt-sheet-table kt-table-grid">
                    <thead>
                    <tr>
                        <th>Date</th>
                        <th>Mileage</th>
                        <th>Event</th>
                        <th>Cost</th>
                        <th class="d-none d-md-table-cell">Station / garage</th>
                        <th class="d-none d-md-table-cell">City</th>
                        <th class="d-none d-md-table-cell">Description</th>
                        <th></th>
                        @if (CanEdit)
                        {
                            <th></th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var entry in SelectedYearEntries)
                    {
                        <CarHistoryRow Entry="entry"
                                       HasWarning="_warningsByEntryId.ContainsKey(entry.Id!)"
                                       WarningMessage="@(_warningsByEntryId.GetValueOrDefault(entry.Id!))"
                                       ReadOnly="@(!CanEdit)"
                                       OnEdit="ShowEditModal" OnDelete="DeleteEntryAsync"/>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (CanEdit)
    {
        <JournalEntryModal Show="ShowModal" Title="@($"{(IsEditMode ? "Edit" : "Add")} history entry")"
                           OnCancel="RequestCancelModal" OnSave="SaveModalEntryAsync"
                           ShowDiscardConfirm="ShowDiscardConfirm" OnConfirmDiscard="ConfirmDiscard" OnCancelDiscard="CancelDiscard">
            <CarHistoryForm Entry="ModalEntry!" ShowFuel="ShowFuel" ShowElectric="ShowElectric"/>
        </JournalEntryModal>
    }
}

@code {
    [Inject] private CarApiClient CarApi { get; set; } = null!;

    [Inject] private CarHistoryApiClient CarHistoryApi { get; set; } = null!;

    protected override CarDto? JournalParent { get => Car; set => Car = value; }

    protected override List<CarHistoryDto>? JournalEntries { get => History; set => History = value; }

    protected override CarMetricsDto? JournalMetrics { get => Metrics; set => Metrics = value; }

    protected override InventoryApiClientBase<CarDto> ParentApi => CarApi;

    protected override InventoryApiClientBase<CarHistoryDto> EntryApi => CarHistoryApi;

    protected override string ParentIdQueryKey => "CarId";

    protected override Task<CarMetricsDto> GetMetricsAsync() => CarApi.GetMetricsAsync(Id);

    protected override Task<SharedDetailDto<CarDto, CarHistoryDto, CarMetricsDto>?> GetSharedAsync(SharedWithMeApiClient sharedApi, string shareId) => sharedApi.GetCarAsync(shareId, Id);

    protected override DateTime EntryDate(CarHistoryDto entry) => entry.HistoryDate;

    protected override CarHistoryDto NewEntry() => CarHistoryForm.NewEntry(Id);

    protected override void OnJournalLoaded() =>
        _warningsByEntryId = Metrics!.MileageWarnings
            .GroupBy(w => w.CarHistoryId)
            .ToDictionary(g => g.Key, g => string.Join(" ", g.Select(w => w.Message)));

    // Public, as [PersistentState] requires: the prerendered journal carries over to the interactive circuit instead of being fetched again.
    [PersistentState]
    public CarDto? Car { get; set; }

    [PersistentState]
    public List<CarHistoryDto>? History { get; set; }

    [PersistentState]
    public CarMetricsDto? Metrics { get; set; }
    private Dictionary<string, string> _warningsByEntryId = [];

    private bool ShowFuel => Car?.EnergyType != CarEnergyType.Electric;

    private bool ShowElectric => Car?.EnergyType is CarEnergyType.Electric or CarEnergyType.Hybrid;

    /// <summary>`ComputeMetrics` always returns a non-null result, even for a brand-new car with no history
    /// at all (empty lists, null averages/next-maintenance) - the metrics panel should only render once
    /// there's actually something in it to show, not just because the object itself isn't null.</summary>
    private bool HasMetricsToShow => Metrics is not null && (
        Metrics.FuelConsumption.Count > 0 ||
        Metrics.ElectricConsumption.Count > 0 ||
        Metrics.CostHistory.Count > 0 ||
        Metrics.MileageWarnings.Count > 0);

    private async Task SaveNameAsync(ChangeEventArgs e)
    {
        if (Car is null) return;
        var name = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(name)) return;
        Car.Name = name;
        await SaveParentAsync();
    }

    private async Task SaveManufacturerAsync(ChangeEventArgs e)
    {
        if (Car is null) return;
        Car.Manufacturer = e.Value?.ToString();
        await SaveParentAsync();
    }

    private async Task SaveModelAsync(ChangeEventArgs e)
    {
        if (Car is null) return;
        Car.Model = e.Value?.ToString();
        await SaveParentAsync();
    }

    private async Task SaveYearAsync(ChangeEventArgs e)
    {
        if (Car is null) return;
        Car.Year = int.TryParse(e.Value?.ToString(), out var year) ? year : null;
        await SaveParentAsync();
    }

    private async Task SaveLicensePlateAsync(ChangeEventArgs e)
    {
        if (Car is null) return;
        Car.LicensePlate = e.Value?.ToString();
        await SaveParentAsync();
    }

    private async Task SetEnergyTypeAsync(CarEnergyType energyType)
    {
        if (Car is null) return;
        Car.EnergyType = energyType;
        await SaveParentAsync();
    }

    private async Task SaveImageUrlAsync(ChangeEventArgs e)
    {
        if (Car is null) return;
        Car.ImageUrl = e.Value?.ToString();
        await SaveParentAsync();
    }

    protected override CarHistoryDto CloneEntry(CarHistoryDto entry) => new()
    {
        Id = entry.Id,
        CarId = entry.CarId,
        HistoryDate = entry.HistoryDate,
        Mileage = entry.Mileage,
        EventType = entry.EventType,
        Description = entry.Description,
        Cost = entry.Cost,
        City = entry.City,
        PostalCode = entry.PostalCode,
        Country = entry.Country,
        Longitude = entry.Longitude,
        Latitude = entry.Latitude,
        FuelCategory = entry.FuelCategory,
        FuelVolume = entry.FuelVolume,
        FuelUnitPrice = entry.FuelUnitPrice,
        ElectricVolume = entry.ElectricVolume,
        ElectricUnitPrice = entry.ElectricUnitPrice,
        IsFullRefill = entry.IsFullRefill,
        DeltaMileage = entry.DeltaMileage,
        // StationId only - StationBrandName/StationCity are server-hydrated display copies, and carrying
        // them into an edit would just send back values the API ignores.
        StationId = entry.StationId,
        Garage = entry.Garage
    };
}
