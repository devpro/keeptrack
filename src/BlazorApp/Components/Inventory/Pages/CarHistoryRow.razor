@* One row of the car history sheet, a compact summary of the most important fields.
   The Edit button below opens the same modal that adds an entry (CarDetail.razor).
   ⚠ (U+26A0) and the edit and delete icons default to text presentation (no FE0F), like HealthRecordRow.razor. *@

<tr class="@(HasWarning ? "kt-history-row-warning" : "")">
    <td>@Entry.HistoryDate.ToString(Entry.HistoryDate.TimeOfDay == TimeSpan.Zero ? "yyyy-MM-dd" : "yyyy-MM-dd HH:mm")</td>
    <td class="kt-num">@Entry.Mileage</td>
    <td>@Entry.EventType</td>
    <td class="kt-num">@Entry.Cost?.ToString("F2")</td>
    @* A refuel carries no location of its own, so both columns read through to its station, hydrated server-side in one lookup per page. *@
    <td class="d-none d-md-table-cell">@(Entry.StationBrandName ?? Entry.Garage)</td>
    <td class="d-none d-md-table-cell">@(Entry.City ?? Entry.StationCity)</td>
    <td class="d-none d-md-table-cell">@Entry.Description</td>
    <td>
        @if (HasWarning)
        {
            <span class="kt-history-warning-icon" title="@WarningMessage">⚠</span>
        }
    </td>
    @if (!ReadOnly)
    {
        <td>
            <div class="d-flex gap-1 justify-content-end">
                <button class="kt-icon-btn" title="Edit this entry" aria-label="Edit this entry" @onclick="() => OnEdit.InvokeAsync(Entry)">✎</button>
                <button class="kt-icon-btn" title="Delete this entry" aria-label="Delete this entry" @onclick="() => OnDelete.InvokeAsync(Entry.Id!)">✕</button>
            </div>
        </td>
    }
</tr>

@code {
    [Parameter] public required CarHistoryDto Entry { get; set; }

    [Parameter] public bool HasWarning { get; set; }

    [Parameter] public string? WarningMessage { get; set; }

    /// <summary>Read-only mode (a recipient viewing a shared car) hides the edit and delete column.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public EventCallback<CarHistoryDto> OnEdit { get; set; }

    [Parameter] public EventCallback<string> OnDelete { get; set; }
}
