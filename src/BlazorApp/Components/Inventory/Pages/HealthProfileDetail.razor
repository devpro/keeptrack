@page "/health/{Id}"
@attribute [Authorize]
@inherits JournalDetailPageBase<HealthProfileDto, HealthRecordDto, HealthMetricsDto>

@if (!IsLoaded)
{
    @if (IsLoading)
    {
        <div class="kt-loading">
            <div class="kt-spinner"></div>
            Loading…
        </div>
    }
}
else if (Profile is null)
{
    <div class="kt-empty">
        <div class="kt-empty-icon"><Icon Name="empty" Size="40" StrokeWidth="1.1"/></div>
        <p>Health profile not found.</p>
    </div>
}
else
{
    @if (CanEdit)
    {
        <Breadcrumb ListRoute="/health" ListLabel="Health" Current="@Profile.Name"/>
    }
    else
    {
        <Breadcrumb ParentRoute="/account/manage/shared-with-me" ParentLabel="Shared with me"
                    ListRoute="@($"/account/manage/shared/{ShareId}")" ListLabel="@(OwnerName ?? "Shared collection")" Current="@Profile.Name"/>
    }

    <div class="kt-page-header">
        <div class="kt-title-row">
            <input class="kt-title-input" value="@Profile.Name" @onchange="SaveNameAsync" disabled="@(!CanEdit)"/>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Profile.ImageUrl))
    {
        <div class="kt-form-card p-0 mb-3" style="overflow:hidden">
            <img src="@Profile.ImageUrl" alt="@Profile.Name cover" style="width:100%;max-height:320px;object-fit:cover;display:block"/>
        </div>
    }

    <div class="kt-form-card">
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">Notes</label>
                <textarea class="form-control form-control-sm" rows="2" @onchange="SaveNotesAsync" disabled="@(!CanEdit)">@Profile.Notes</textarea>
            </div>
            @if (CanEdit)
            {
                <div class="col-12">
                    <label class="form-label">Cover image URL</label>
                    <input class="form-control form-control-sm" data-testid="image-url-input" value="@Profile.ImageUrl" @onchange="SaveImageUrlAsync"/>
                </div>
            }
        </div>
    </div>

    @* No summary panels before the journal on purpose (owner feedback):
       the journal is the page's primary content, and the per-row warning sign is the whole warning surface.
       "Last seen" is a bare specialty + last-date list - no names, no counts, no field labels. *@
    @if (Metrics is { LastVisits.Count: > 0 })
    {
        <h2 class="kt-section-title">Last seen</h2>
        <div class="kt-form-card">
            @foreach (var visit in Metrics.LastVisits)
            {
                <div class="d-flex justify-content-between" style="max-width:420px">
                    <span>@visit.Specialty</span>
                    <span class="kt-card-meta">@visit.LastVisitDate.ToString("yyyy-MM-dd")</span>
                </div>
            }
        </div>
    }

    <div class="d-flex justify-content-between align-items-center">
        <h2 class="kt-section-title">Journal</h2>
        @if (CanEdit)
        {
            <button class="btn btn-sm btn-primary" @onclick="ShowAddModal">+ Add entry</button>
        }
    </div>
    @* Excel-like on purpose: no header row, no per-field labels, aligned columns at every width
       (kt-table-grid opts out of the mobile stacked-cards treatment) - date, specialty, name, a warning
       sign when money remains unaccounted, and edit/delete icons. Everything else lives in the modal.
       One tab per year (same kt-season-picker/kt-page-btn header as TvShowDetail.razor's season tabs),
       newest year first, so a long-running journal doesn't render every entry on one page. *@
    @if (Records!.Count == 0)
    {
        <div class="kt-table-wrap">
            <div class="table-responsive">
                <table class="table kt-sheet-table kt-table-grid mb-0">
                    <tbody>
                    <tr><td class="text-center kt-card-meta">@(CanEdit ? "No entries yet - add the first one above." : "No entries recorded.")</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="kt-season-picker">
            @foreach (var year in Years)
            {
                <button class="kt-page-btn @(year == SelectedYear ? "active" : "")" @onclick="() => SelectYear(year)">@year</button>
            }
        </div>
        <div class="kt-table-wrap">
            <div class="table-responsive">
                <table class="table kt-sheet-table kt-table-grid mb-0">
                    @* The journal is the one table here that had no header row, while the yearly review
                       directly below it does - so its columns had to be inferred from their contents.
                       Column set and the d-none d-md-table-cell breakpoints mirror HealthRecordRow. *@
                    <thead>
                    <tr>
                        <th>Date</th>
                        <th>Specialty</th>
                        <th>Practitioner</th>
                        <th class="d-none d-md-table-cell">Description</th>
                        <th class="d-none d-md-table-cell kt-num">Price</th>
                        <th><span class="visually-hidden">To check</span></th>
                        @if (CanEdit)
                        {
                            <th><span class="visually-hidden">Actions</span></th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var entry in SelectedYearEntries)
                    {
                        <HealthRecordRow Entry="entry" IsUnbalanced="@UnbalancedRecordIds.Contains(entry.Id!)" ReadOnly="@(!CanEdit)" OnEdit="ShowEditModal" OnDelete="DeleteEntryAsync"/>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Metrics is { CostHistory.Count: > 0 })
    {
        <h2 class="kt-section-title">Yearly cost review</h2>
        <div class="kt-table-wrap">
            <div class="table-responsive">
                <table class="table kt-sheet-table kt-table-grid">
                    <thead>
                    <tr>
                        <th>Year</th>
                        <th>Paid</th>
                        <th>Reimbursed</th>
                        <th>Out of pocket</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var point in Metrics.CostHistory)
                    {
                        <tr>
                            <td style="font-weight:500">@point.Year</td>
                            <td data-label="Paid">@point.TotalPaid.ToString("F2")</td>
                            <td data-label="Reimbursed">@point.TotalReimbursed.ToString("F2")</td>
                            <td data-label="Out of pocket" style="font-weight:600">@point.OutOfPocket.ToString("F2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (CanEdit)
    {
        <JournalEntryModal Show="ShowModal" Title="@($"{(IsEditMode ? "Edit" : "Add")} journal entry")"
                           OnCancel="RequestCancelModal" OnSave="SaveModalEntryAsync"
                           ShowDiscardConfirm="ShowDiscardConfirm" OnConfirmDiscard="ConfirmDiscard" OnCancelDiscard="CancelDiscard">
            <HealthRecordForm Entry="ModalEntry!"/>
        </JournalEntryModal>
    }
}

@code {
    [Inject] private HealthProfileApiClient HealthProfileApi { get; set; } = null!;

    [Inject] private HealthRecordApiClient HealthRecordApi { get; set; } = null!;

    protected override HealthProfileDto? JournalParent { get => Profile; set => Profile = value; }

    protected override List<HealthRecordDto>? JournalEntries { get => Records; set => Records = value; }

    protected override HealthMetricsDto? JournalMetrics { get => Metrics; set => Metrics = value; }

    protected override InventoryApiClientBase<HealthProfileDto> ParentApi => HealthProfileApi;

    protected override InventoryApiClientBase<HealthRecordDto> EntryApi => HealthRecordApi;

    protected override string ParentIdQueryKey => "HealthProfileId";

    protected override Task<HealthMetricsDto> GetMetricsAsync() => HealthProfileApi.GetMetricsAsync(Id);

    protected override Task<SharedDetailDto<HealthProfileDto, HealthRecordDto, HealthMetricsDto>?> GetSharedAsync(SharedWithMeApiClient sharedApi, string shareId) => sharedApi.GetHealthProfileAsync(shareId, Id);

    protected override DateTime EntryDate(HealthRecordDto entry) => entry.HistoryDate;

    protected override HealthRecordDto NewEntry() => HealthRecordForm.NewEntry(Id);

    // Public, as [PersistentState] requires: the prerendered journal carries over to the interactive circuit instead of being fetched again.
    [PersistentState]
    public HealthProfileDto? Profile { get; set; }

    [PersistentState]
    public List<HealthRecordDto>? Records { get; set; }

    [PersistentState]
    public HealthMetricsDto? Metrics { get; set; }

    /// <summary>The journal rows' warning flags come from the metrics (the one balance computation,
    /// server-side in HealthMetricsService) rather than re-deriving the arithmetic per row.</summary>
    private HashSet<string> UnbalancedRecordIds =>
        Metrics is null ? [] : [.. Metrics.UnbalancedRecords.Select(u => u.RecordId)];

    private async Task SaveNameAsync(ChangeEventArgs e)
    {
        if (Profile is null) return;
        var name = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(name)) return;
        Profile.Name = name;
        await SaveParentAsync();
    }

    private async Task SaveNotesAsync(ChangeEventArgs e)
    {
        if (Profile is null) return;
        Profile.Notes = e.Value?.ToString();
        await SaveParentAsync();
    }

    private async Task SaveImageUrlAsync(ChangeEventArgs e)
    {
        if (Profile is null) return;
        Profile.ImageUrl = e.Value?.ToString();
        await SaveParentAsync();
    }

    protected override HealthRecordDto CloneEntry(HealthRecordDto entry) => new()
    {
        Id = entry.Id,
        HealthProfileId = entry.HealthProfileId,
        HistoryDate = entry.HistoryDate,
        EventType = entry.EventType,
        Specialty = entry.Specialty,
        Practitioner = entry.Practitioner,
        Description = entry.Description,
        Notes = entry.Notes,
        Price = entry.Price,
        PublicReimbursement = entry.PublicReimbursement,
        InsuranceReimbursement = entry.InsuranceReimbursement,
        NotCovered = entry.NotCovered
    };
}
