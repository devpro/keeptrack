@page "/houses/{Id}"
@attribute [Authorize]
@inherits JournalDetailPageBase<HouseDto, HouseHistoryDto, HouseMetricsDto>

@if (!IsLoaded)
{
    @if (IsLoading)
    {
        <div class="kt-loading">
            <div class="kt-spinner"></div>
            Loading…
        </div>
    }
}
else if (House is null)
{
    <div class="kt-empty">
        <div class="kt-empty-icon"><Icon Name="empty" Size="40" StrokeWidth="1.1"/></div>
        <p>House not found.</p>
    </div>
}
else
{
    @if (CanEdit)
    {
        <Breadcrumb ListRoute="/houses" ListLabel="Houses" Current="@House.Name"/>
    }
    else
    {
        <Breadcrumb ParentRoute="/account/manage/shared-with-me" ParentLabel="Shared with me"
                    ListRoute="@($"/account/manage/shared/{ShareId}")" ListLabel="@(OwnerName ?? "Shared collection")" Current="@House.Name"/>
    }

    <div class="kt-page-header">
        <div class="kt-title-row">
            <input class="kt-title-input" value="@House.Name" @onchange="SaveNameAsync" disabled="@(!CanEdit)"/>
        </div>
    </div>

    <div class="d-flex gap-2 mb-3">
        @foreach (var propertyType in Enum.GetValues<PropertyType>())
        {
            <button class="btn btn-sm @(House.PropertyType == propertyType ? "btn-primary" : "btn-secondary")" @onclick="() => SetPropertyTypeAsync(propertyType)" disabled="@(!CanEdit)">@propertyType</button>
        }
    </div>

    @if (!string.IsNullOrEmpty(House.ImageUrl))
    {
        <div class="kt-form-card p-0 mb-3" style="overflow:hidden">
            <img src="@House.ImageUrl" alt="@House.Name cover" style="width:100%;max-height:320px;object-fit:cover;display:block"/>
        </div>
    }

    <div class="kt-form-card">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">City</label>
                <input class="form-control form-control-sm" value="@House.City" @onchange="SaveCityAsync" disabled="@(!CanEdit)"/>
            </div>
            <div class="col-md-3">
                <label class="form-label">Moved in</label>
                <input class="form-control form-control-sm" type="date" value="@House.MovedInAt?.ToString("yyyy-MM-dd")" @onchange="SaveMovedInAtAsync" disabled="@(!CanEdit)"/>
            </div>
            <div class="col-md-3">
                <label class="form-label">Moved out</label>
                <input class="form-control form-control-sm" type="date" value="@House.MovedOutAt?.ToString("yyyy-MM-dd")" @onchange="SaveMovedOutAtAsync" disabled="@(!CanEdit)"/>
            </div>
            <div class="col-12">
                <label class="form-label">Notes</label>
                <textarea class="form-control form-control-sm" rows="2" @onchange="SaveNotesAsync" disabled="@(!CanEdit)">@House.Notes</textarea>
            </div>
            @if (CanEdit)
            {
                <div class="col-12">
                    <label class="form-label">Cover image URL</label>
                    <input class="form-control form-control-sm" data-testid="image-url-input" value="@House.ImageUrl" @onchange="SaveImageUrlAsync"/>
                </div>
            }
        </div>
    </div>

    @if (HasMetricsToShow)
    {
        var metrics = Metrics!;
        <h2 class="kt-section-title">Yearly cost review</h2>
        <div class="kt-form-card">
            <p class="kt-card-meta mb-1">Total cost by year - @metrics.CostHistory.Sum(p => p.TotalCost).ToString("F2") across the whole history</p>
            <HouseCostHistoryChart Points="metrics.CostHistory"/>

            <div class="table-responsive mt-3">
                <table class="table kt-sheet-table">
                    <thead>
                    <tr>
                        <th>Year</th>
                        @foreach (var eventType in Enum.GetValues<HouseEventType>())
                        {
                            <th>@eventType</th>
                        }
                        <th>Total</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var point in metrics.CostHistory)
                    {
                        <tr>
                            <td style="font-weight:500">@point.Year</td>
                            @foreach (var eventType in Enum.GetValues<HouseEventType>())
                            {
                                <td data-label="@eventType">@(point.CostByCategory.FirstOrDefault(c => c.EventType == eventType)?.Cost.ToString("F2") ?? "-")</td>
                            }
                            <td data-label="Total" style="font-weight:600">@point.TotalCost.ToString("F2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Metrics is { LastRecords.Count: > 0 })
    {
        <h2 class="kt-section-title">Last record</h2>
        <div class="kt-form-card">
            @foreach (var record in Metrics.LastRecords)
            {
                <div class="d-flex justify-content-between" style="max-width:420px">
                    <span>@record.EventType</span>
                    <span class="kt-card-meta">@record.LastDate.ToString("yyyy-MM-dd")</span>
                </div>
            }
        </div>
    }

    <div class="d-flex justify-content-between align-items-center">
        <h2 class="kt-section-title">History</h2>
        @if (CanEdit)
        {
            <button class="btn btn-sm btn-primary" @onclick="ShowAddModal">+ Add entry</button>
        }
    </div>
    @* kt-table-grid opts this table out of the mobile stacked-cards treatment (see HealthProfileDetail.razor's
       journal for the same pattern) - a real spreadsheet-like grid with only the most important columns
       (Provider/Description) stay desktop-only via d-none d-md-table-cell.
       One tab per year (same kt-season-picker/kt-page-btn header as TvShowDetail.razor's season tabs and
       HealthProfileDetail.razor's journal), newest year first. *@
    @if (History!.Count == 0)
    {
        <div class="kt-table-wrap">
            <div class="table-responsive">
                <table class="table kt-sheet-table kt-table-grid">
                    <tbody>
                    <tr><td class="text-center kt-card-meta">@(CanEdit ? "No history yet - add the first entry above." : "No history recorded.")</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="kt-season-picker">
            @foreach (var year in Years)
            {
                <button class="kt-page-btn @(year == SelectedYear ? "active" : "")" @onclick="() => SelectYear(year)">@year</button>
            }
        </div>
        <div class="kt-table-wrap">
            <div class="table-responsive">
                <table class="table kt-sheet-table kt-table-grid">
                    <thead>
                    <tr>
                        <th>Date</th>
                        <th>Event</th>
                        <th>Cost</th>
                        <th class="d-none d-md-table-cell">Provider</th>
                        <th class="d-none d-md-table-cell">Description</th>
                        @if (CanEdit)
                        {
                            <th></th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var entry in SelectedYearEntries)
                    {
                        <HouseHistoryRow Entry="entry" ReadOnly="@(!CanEdit)" OnEdit="ShowEditModal" OnDelete="DeleteEntryAsync"/>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (CanEdit)
    {
        <JournalEntryModal Show="ShowModal" Title="@($"{(IsEditMode ? "Edit" : "Add")} history entry")"
                           OnCancel="RequestCancelModal" OnSave="SaveModalEntryAsync"
                           ShowDiscardConfirm="ShowDiscardConfirm" OnConfirmDiscard="ConfirmDiscard" OnCancelDiscard="CancelDiscard">
            <HouseHistoryForm Entry="ModalEntry!"/>
        </JournalEntryModal>
    }
}

@code {
    [Inject] private HouseApiClient HouseApi { get; set; } = null!;

    [Inject] private HouseHistoryApiClient HouseHistoryApi { get; set; } = null!;

    protected override HouseDto? JournalParent { get => House; set => House = value; }

    protected override List<HouseHistoryDto>? JournalEntries { get => History; set => History = value; }

    protected override HouseMetricsDto? JournalMetrics { get => Metrics; set => Metrics = value; }

    protected override InventoryApiClientBase<HouseDto> ParentApi => HouseApi;

    protected override InventoryApiClientBase<HouseHistoryDto> EntryApi => HouseHistoryApi;

    protected override string ParentIdQueryKey => "HouseId";

    protected override Task<HouseMetricsDto> GetMetricsAsync() => HouseApi.GetMetricsAsync(Id);

    protected override Task<SharedDetailDto<HouseDto, HouseHistoryDto, HouseMetricsDto>?> GetSharedAsync(SharedWithMeApiClient sharedApi, string shareId) => sharedApi.GetHouseAsync(shareId, Id);

    protected override DateTime EntryDate(HouseHistoryDto entry) => entry.HistoryDate.ToDateTime(TimeOnly.MinValue);

    protected override HouseHistoryDto NewEntry() => HouseHistoryForm.NewEntry(Id);

    // Public, as [PersistentState] requires: the prerendered journal carries over to the interactive circuit instead of being fetched again.
    [PersistentState]
    public HouseDto? House { get; set; }

    [PersistentState]
    public List<HouseHistoryDto>? History { get; set; }

    [PersistentState]
    public HouseMetricsDto? Metrics { get; set; }

    /// <summary>`ComputeMetrics` always returns a non-null result, even for a brand-new house with no history
    /// at all (an empty list) - the metrics panel should only render once there's actually something in it
    /// to show, not just because the object itself isn't null.</summary>
    private bool HasMetricsToShow => Metrics is { CostHistory.Count: > 0 };

    private async Task SaveNameAsync(ChangeEventArgs e)
    {
        if (House is null) return;
        var name = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(name)) return;
        House.Name = name;
        await SaveParentAsync();
    }

    private async Task SetPropertyTypeAsync(PropertyType propertyType)
    {
        if (House is null) return;
        House.PropertyType = propertyType;
        await SaveParentAsync();
    }

    private async Task SaveCityAsync(ChangeEventArgs e)
    {
        if (House is null) return;
        House.City = e.Value?.ToString();
        await SaveParentAsync();
    }

    private async Task SaveMovedInAtAsync(ChangeEventArgs e)
    {
        if (House is null) return;
        House.MovedInAt = DateOnlyInput.Parse(e.Value);
        await SaveParentAsync();
    }

    private async Task SaveMovedOutAtAsync(ChangeEventArgs e)
    {
        if (House is null) return;
        House.MovedOutAt = DateOnlyInput.Parse(e.Value);
        await SaveParentAsync();
    }

    private async Task SaveNotesAsync(ChangeEventArgs e)
    {
        if (House is null) return;
        House.Notes = e.Value?.ToString();
        await SaveParentAsync();
    }

    private async Task SaveImageUrlAsync(ChangeEventArgs e)
    {
        if (House is null) return;
        House.ImageUrl = e.Value?.ToString();
        await SaveParentAsync();
    }

    protected override HouseHistoryDto CloneEntry(HouseHistoryDto entry) => new()
    {
        Id = entry.Id,
        HouseId = entry.HouseId,
        HistoryDate = entry.HistoryDate,
        EventType = entry.EventType,
        Description = entry.Description,
        Cost = entry.Cost,
        Provider = entry.Provider
    };
}
