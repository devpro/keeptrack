@page "/movies/{Id}"
@attribute [Authorize]
@inherits ReferenceLinkedDetailPageBase<MovieDto, MovieReferenceDto>
@using Keeptrack.BlazorApp.Components.ReferenceData
@using Keeptrack.BlazorApp.Components.ReferenceDataAdmin

@if (!IsLoaded)
{
    @if (IsLoading)
    {
        <div class="kt-loading">
            <div class="kt-spinner"></div>
            Loading…
        </div>
    }
}
else if (Movie is null)
{
    <div class="kt-empty">
        <div class="kt-empty-icon"><Icon Name="empty" Size="40" StrokeWidth="1.1"/></div>
        <p>Movie not found.</p>
    </div>
}
else
{
    <Breadcrumb ListRoute="/movies" ListLabel="Movies" Current="@Movie.Title"/>

    <div class="kt-page-header">
        <div class="kt-title-row">
            <input class="kt-title-input" value="@Movie.Title" @onchange="SaveTitleAsync"/>
            <ReferenceMatchControls TDto="MovieDto" Api="Api" ItemId="@(Movie.Id!)" ReferenceId="@Movie.ReferenceId" ReferenceTitle="@Reference?.Title"
                                    ReferenceDataDescription="cover, synopsis, cast/genres"
                                    OnChecked="OnReferenceCheckedAsync" OnUnlinked="LoadAsync"/>
        </div>
        @* "Watched" is deliberately NOT here: it lives on the card below as a .kt-corner-flag, because
           "have I seen this" outranks these three flags and the success green says "finished" where their
           accent blue only says "flagged". *@
        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-sm kt-toggle-btn @(Movie.IsFavorite ? "active" : "")" @onclick="ToggleFavoriteAsync">Favorites</button>
            <button class="btn btn-sm kt-toggle-btn @(Movie.WantToWatch ? "active" : "")" @onclick="ToggleWantToWatchAsync">Watchlist</button>
            <button class="btn btn-sm kt-toggle-btn @(Movie.IsWishlisted ? "active" : "")" @onclick="ToggleWishlistedAsync"><Icon Name="wishlist" Size="13"/> Wishlist</button>
        </div>
    </div>
    @if (ShowLinker)
    {
        <AuthorizeView Policy="AdminOnly">
            <Authorized>
                <InlineReferenceLinker Type="ReferenceItemType.Movie" Title="@Movie.Title" Year="Movie.Year" OnLinked="LoadAsync"/>
            </Authorized>
        </AuthorizeView>
    }

    <div class="kt-form-card">
        <button type="button" class="kt-corner-flag @(Movie.FirstSeenAt is not null ? "active" : "")"
                aria-pressed="@(Movie.FirstSeenAt is not null)" @onclick="ToggleWatchedAsync">
            @if (Movie.FirstSeenAt is not null)
            {
                <span class="kt-corner-check">✓</span>
                <span>Watched</span>
            }
            else
            {
                <span>Mark as watched</span>
            }
        </button>
        <DetailHero ImageUrl="@Reference?.ImageUrl" Alt="@($"{Movie.Title} poster")">
            <div class="col-6">
                <label class="form-label">Year</label>
                <input class="form-control form-control-sm" type="number" min="1970" max="2100" data-testid="year-input"
                       value="@Movie.Year" @onchange="SaveYearAsync"/>
            </div>
            @if (Movie.FirstSeenAt is not null)
            {
                <div class="col-6">
                    <label class="form-label">Watched on</label>
                    <input class="form-control form-control-sm" type="date"
                           value="@Movie.FirstSeenAt?.ToString("yyyy-MM-dd")" @onchange="SetWatchedDateAsync"/>
                </div>
            }
            <div class="col-12">
                <label class="form-label">Rating</label>
                <StarRatingInput Rating="Movie.Rating" RatingChanged="SetRatingAsync"/>
            </div>
            @if (Reference?.Ratings.Count > 0)
            {
                <div class="col-12">
                    <label class="form-label">Reference rating</label>
                    <ReferenceRatings Ratings="Reference.Ratings"/>
                </div>
            }
            @if (Reference?.Genres.Count > 0)
            {
                <div class="col-12">
                    <p class="kt-card-meta mb-0">@string.Join(", ", Reference.Genres)</p>
                </div>
            }
            <div class="col-12">
                <label class="form-label">Notes</label>
                <textarea class="form-control" rows="3" @onchange="SaveNotesAsync">@Movie.Notes</textarea>
            </div>
        </DetailHero>
        @if (!string.IsNullOrEmpty(Reference?.Synopsis))
        {
            <hr/>
            <p class="mb-0" style="color:var(--kt-text-muted)">@Reference.Synopsis</p>
        }
    </div>

    <OwnedVersionsEditor Versions="Movie.OwnedVersions" OnChanged="SaveAsync"/>

    @if (Reference?.Cast.Count > 0)
    {
        <h2 class="kt-section-title">Cast</h2>
        <CastGrid Cast="Reference.Cast"/>
    }
}

@code {
    [Inject] private MovieApiClient MovieApi { get; set; } = null!;

    [Inject] private ReferenceDataApiClient ReferenceDataApi { get; set; } = null!;

    protected override InventoryApiClientBase<MovieDto> Api => MovieApi;

    protected override MovieDto? Item { get => Movie; set => Movie = value; }

    protected override MovieReferenceDto? ItemReference { get => Reference; set => Reference = value; }

    protected override Task<MovieReferenceDto?> GetReferenceAsync(string referenceId) => ReferenceDataApi.GetMovieAsync(referenceId);

    // Public, as [PersistentState] requires: the prerendered item carries over to the interactive circuit instead of being fetched again.
    [PersistentState]
    public MovieDto? Movie { get; set; }

    [PersistentState]
    public MovieReferenceDto? Reference { get; set; }

    private async Task ToggleFavoriteAsync()
    {
        if (Movie is null) return;
        Movie.IsFavorite = !Movie.IsFavorite;
        await SaveAsync();
    }

    private async Task ToggleWantToWatchAsync()
    {
        if (Movie is null) return;
        Movie.WantToWatch = !Movie.WantToWatch;
        await SaveAsync();
    }

    private async Task ToggleWishlistedAsync()
    {
        if (Movie is null) return;
        Movie.IsWishlisted = !Movie.IsWishlisted;
        await SaveAsync();
    }

    private async Task SetRatingAsync(float rating)
    {
        if (Movie is null) return;
        Movie.Rating = rating;
        await SaveAsync();
    }

    private async Task ToggleWatchedAsync()
    {
        if (Movie is null) return;
        Movie.FirstSeenAt = Movie.FirstSeenAt is null ? DateOnly.FromDateTime(DateTime.Today) : null;
        await SaveAsync();
    }

    private async Task SetWatchedDateAsync(ChangeEventArgs e)
    {
        if (Movie is null) return;
        Movie.FirstSeenAt = DateOnlyInput.Parse(e.Value);
        await SaveAsync();
    }

    private async Task SaveTitleAsync(ChangeEventArgs e)
    {
        if (Movie is null) return;
        var title = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(title)) return;
        Movie.Title = title;
        await SaveAsync();
    }

    private async Task SaveYearAsync(ChangeEventArgs e)
    {
        if (Movie is null) return;
        Movie.Year = int.TryParse(e.Value?.ToString(), out var year) ? year : null;
        await SaveAsync();
    }

    private async Task SaveNotesAsync(ChangeEventArgs e)
    {
        if (Movie is null) return;
        Movie.Notes = e.Value?.ToString();
        await SaveAsync();
    }
}
