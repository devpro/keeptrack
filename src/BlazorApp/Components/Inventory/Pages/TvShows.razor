@page "/tv-shows"
@inherits InventoryPageBase<TvShowDto>
@attribute [Authorize]

<InventoryList TDto="TvShowDto"
               Title="TV Shows"
               ItemName="TV show"
               Route="@ListRoute"
               View="@_view"
               OnViewChanged="@SetView"
               Items="@(Items ?? [])"
               Loading="@_loading"
               Loaded="@_loaded"
               Error="@_error"
               Search="@_search"
               Page="@_page"
               TotalPages="@TotalPages"
               TotalCount="@TotalCount"
               ShowForm="@_showForm"
               Form="@_form"
               ItemTitle="@(show => show.Title)"
               ItemImageUrl="@(show => show.ImageUrl)"
               OnSearchKeyUp="@OnSearchKeyUp"
               OnClearSearch="@ClearSearch"
               OnGoToPage="@GoToPage"
               OnShowAddForm="@ShowAddForm"
               OnCancelForm="@CancelForm"
               OnSave="@SaveAsync"
               OnDelete="@DeleteAsync"
               OnSearchChanged="@OnSearchChanged"
               Sort="@_sort"
               OnSortChanged="@SetSort"
               HasRatingSort="true"
               HasReferenceRatingSort="true">
    <Filters>
        <button class="btn btn-sm @(StateFilter is null ? "btn-primary" : "btn-secondary")" @onclick='() => SetFilter("state", null)'>All</button>
        <button class="btn btn-sm @(StateFilter == TvShowStatus.Current ? "btn-primary" : "btn-secondary")" @onclick='() => SetFilter("state", nameof(TvShowStatus.Current))'>Current</button>
        <button class="btn btn-sm @(StateFilter == TvShowStatus.Finished ? "btn-primary" : "btn-secondary")" @onclick='() => SetFilter("state", nameof(TvShowStatus.Finished))'>Finished</button>
        <button class="btn btn-sm @(StateFilter == TvShowStatus.Stopped ? "btn-primary" : "btn-secondary")" @onclick='() => SetFilter("state", nameof(TvShowStatus.Stopped))'>Stopped</button>
        <button class="btn btn-sm kt-toggle-btn @(FavoriteFilter ? "active" : "")" @onclick='() => ToggleFilter("favorite", FavoriteFilter)'><Icon Name="favorite" Size="13"/> Favorites</button>
        <button class="btn btn-sm kt-toggle-btn @(OwnedFilter ? "active" : "")" @onclick='() => ToggleFilter("owned", OwnedFilter)'><Icon Name="owned" Size="13"/> Owned</button>
    </Filters>
    <MetaTemplate Context="show">
        <TvShowMetaRow Item="show"/>
    </MetaTemplate>
    <FormTemplate Context="show">
        <div class="col-12">
            <input class="form-control" placeholder="Title" data-testid="title-input" @bind="show.Title"/>
        </div>
        <div class="col-6 col-md-4">
            <input class="form-control" placeholder="Year" data-testid="year-input" @bind="show.Year" type="number" min="1970" max="2100"/>
        </div>
    </FormTemplate>
</InventoryList>
