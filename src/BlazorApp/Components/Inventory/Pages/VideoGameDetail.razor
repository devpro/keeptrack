@page "/video-games/{Id}"
@attribute [Authorize]
@inherits ReferenceLinkedDetailPageBase<VideoGameDto, VideoGameReferenceDto>
@using Keeptrack.BlazorApp.Components.ReferenceData
@using Keeptrack.BlazorApp.Components.ReferenceDataAdmin

@if (!IsLoaded)
{
    @if (IsLoading)
    {
        <div class="kt-loading">
            <div class="kt-spinner"></div>
            Loading…
        </div>
    }
}
else if (Game is null)
{
    <div class="kt-empty">
        <div class="kt-empty-icon"><Icon Name="empty" Size="40" StrokeWidth="1.1"/></div>
        <p>Video game not found.</p>
    </div>
}
else
{
    @* The whole page sits in one narrow column so the artwork, the fields and the platform cards share a width.
       .content is 1100px wide for list pages that genuinely need it, which leaves this page's text lines far longer than the banner above them. *@
    <div class="kt-game-page">
    <Breadcrumb ListRoute="/video-games" ListLabel="Video games" Current="@Game.Title"/>

    <div class="kt-page-header">
        <div class="kt-title-row">
            <input class="kt-title-input" value="@Game.Title" @onchange="SaveTitleAsync"/>
            <ReferenceMatchControls TDto="VideoGameDto" Api="Api" ItemId="@(Game.Id!)" ReferenceId="@Game.ReferenceId" ReferenceTitle="@Reference?.Title"
                                    ReferenceDataDescription="cover, synopsis, genres/platforms"
                                    OnChecked="OnReferenceCheckedAsync" OnUnlinked="LoadAsync"/>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm kt-toggle-btn @(Game.IsWishlisted ? "active" : "")" @onclick="ToggleWishlistedAsync"><Icon Name="wishlist" Size="13"/> Wishlist</button>
        </div>
    </div>

    @if (ShowLinker)
    {
        <AuthorizeView Policy="AdminOnly">
            <Authorized>
                <InlineReferenceLinker Type="ReferenceItemType.VideoGame" Title="@Game.Title" Year="Game.Year" OnLinked="LoadAsync"/>
            </Authorized>
        </AuthorizeView>
    }

    @* A 16:9 banner, because that is what the artwork actually is: nearly every stored cover here is RAWG key art at exactly that ratio.
       It fills the banner's whole width, so there is never empty space beside it.
       See .kt-game-banner in app.css for the measured ratios and for what the few odd ones lose. *@
    @{
        var artUrl = !string.IsNullOrEmpty(Game.CustomImageUrl) ? Game.CustomImageUrl : Reference?.ImageUrl;
    }
    <div class="kt-game-banner @(string.IsNullOrEmpty(artUrl) ? "kt-game-banner-none" : null)">
        @if (!string.IsNullOrEmpty(artUrl))
        {
            <img class="kt-game-banner-art" src="@artUrl" alt="@($"{Game.Title} cover")"/>
        }
        else
        {
            <div class="kt-game-banner-empty"><CoverPlaceholder Title="@Game.Title"/></div>
        }
    </div>

    <div class="kt-form-card">
        <div class="row g-3">
            @* col-auto, not col-6: a forced half-row is narrower than the star input on a phone, which wraps the fifth star onto its own line. *@
            <div class="col-auto">
                <label class="form-label">Year</label>
                <input class="form-control form-control-sm" style="max-width:120px" type="number" min="1970" max="2100"
                       data-testid="year-input" value="@Game.Year" @onchange="SaveYearAsync"/>
            </div>
            <div class="col-auto">
                <label class="form-label">Rating</label>
                <StarRatingInput Rating="Game.Rating" RatingChanged="SetRatingAsync"/>
            </div>
            @if (Reference?.Ratings.Count > 0)
            {
                <div class="col-12 col-md-auto">
                    <label class="form-label">Reference rating</label>
                    <ReferenceRatings Ratings="Reference.Ratings"/>
                </div>
            }
            @if (Reference?.Genres.Count > 0)
            {
                <div class="col-12">
                    <label class="form-label">Genres</label>
                    <div class="kt-chip-row">
                        @foreach (var genre in Reference.Genres)
                        {
                            <span class="kt-chip">@genre</span>
                        }
                    </div>
                </div>
            }
            @if (Reference?.Platforms.Count > 0)
            {
                @* "Released on", not "Available on": these are the platforms the game exists on, a different thing from the Platforms section below, where each entry is a copy owned. *@
                <div class="col-12">
                    <label class="form-label">Released on</label>
                    <div class="kt-chip-row">
                        @foreach (var platform in Reference.Platforms)
                        {
                            <span class="kt-chip">@platform</span>
                        }
                    </div>
                </div>
            }
            <div class="col-12">
                <label class="form-label">Notes</label>
                <textarea class="form-control" rows="4" @onchange="SaveNotesAsync">@Game.Notes</textarea>
            </div>
            @* A raw URL box earns no room at the top of the page, so it stays folded away unless this item already carries one, where hiding it would make the value uneditable. *@
            <div class="col-12">
                @if (_editingCover || !string.IsNullOrEmpty(Game.CustomImageUrl))
                {
                    <label class="form-label">Cover image URL</label>
                    <input class="form-control form-control-sm" placeholder="@(Reference?.ImageUrl is null ? "" : "Leave blank to use the linked reference's cover")"
                           value="@Game.CustomImageUrl" @onchange="SaveCustomImageUrlAsync"/>
                }
                else
                {
                    <button class="btn btn-sm btn-secondary" @onclick="() => _editingCover = true">Use a different cover</button>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Reference?.Synopsis))
        {
            <hr/>
            <p class="mb-0" style="color:var(--kt-text-muted)">@Reference.Synopsis</p>
        }
    </div>

    <h2 class="kt-section-title">Platforms</h2>

    <ConfirmModal Show="_pendingRemovePlatform is not null"
                  Title="Remove this platform?"
                  Message="This will remove this platform entry and its details (state, completion, playthroughs). This can't be undone."
                  ConfirmLabel="Remove"
                  OnConfirm="ConfirmRemovePlatformAsync" OnCancel="() => _pendingRemovePlatform = null"/>

    @if (Game.Platforms.Count == 0 && _draftPlatform is null)
    {
        <p class="kt-card-meta">No platforms tracked yet - add one below.</p>
    }

    @foreach (var entry in Game.Platforms)
    {
        @* A platform entry *is* this game's copy, so it takes the same kt-copy-card treatment as
           OwnedVersionsEditor's cards - full-width equal columns, no field-grid cap. *@
        <div class="kt-form-card kt-copy-card mb-3">
            @* The card's own header carries this copy's state, so a game owned on three platforms reads at a glance instead of through each card's controls.
               Same badges as the list row. *@
            <div class="kt-copy-card-header">
                <h3>@entry.Platform</h3>
                @if (!string.IsNullOrEmpty(entry.State))
                {
                    <span class="kt-status-badge @VideoGames.StateBadgeClass(entry.State)">@entry.State</span>
                }
                @if (entry.IsFullyCompleted)
                {
                    <span class="kt-status-badge completed">✓ Fully completed</span>
                }
                @if (entry.Playthroughs.Count > 0)
                {
                    <span class="kt-card-meta">@entry.Playthroughs.Count playthrough@(entry.Playthroughs.Count > 1 ? "s" : "")</span>
                }
            </div>
            <OwnedVersionFields Copy="entry" OnChanged="SaveAsync">
                <ButtonRowSuffix>
                    <button class="kt-icon-btn" title="Remove this platform" aria-label="Remove this platform" @onclick="() => RequestRemovePlatformAsync(entry)">
                        <Icon Name="trash" Size="15"/>
                    </button>
                </ButtonRowSuffix>
                <ExtraFields>
                    <div class="col-6 col-md">
                        <label class="form-label">Product</label>
                        <input class="form-control form-control-sm" placeholder="Store product/edition name…"
                               value="@entry.ProductName" @onchange="e => SetPlatformProductNameAsync(entry, e)"/>
                    </div>
                </ExtraFields>
            </OwnedVersionFields>

            <hr class="my-3"/>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">State</label>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        @foreach (var state in VideoGames.VideoGameStates)
                        {
                            <button class="btn btn-sm @(entry.State == state ? "btn-primary" : "btn-secondary")" @onclick="() => SetPlatformStateAsync(entry, state)">@state</button>
                        }
                    </div>
                    @if (entry.State == "Completed")
                    {
                        <div class="d-flex gap-2 align-items-center mt-2">
                            <span class="kt-card-meta">Completed on</span>
                            <input class="form-control form-control-sm" style="max-width:170px" type="date"
                                   value="@entry.CompletedAt?.ToString("yyyy-MM-dd")" @onchange="e => SetPlatformCompletedDateAsync(entry, e)"/>
                        </div>
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label">Completion</label>
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <button class="btn btn-sm @(entry.IsFullyCompleted ? "btn-primary" : "btn-secondary")" @onclick="() => ToggleFullyCompletedAsync(entry)">
                            @(entry.IsFullyCompleted ? "✓ Fully completed" : "Mark fully completed")
                        </button>
                        @if (entry.IsFullyCompleted)
                        {
                            <div class="d-flex gap-2 align-items-center">
                                <span class="kt-card-meta">on</span>
                                <input class="form-control form-control-sm" style="max-width:170px" type="date"
                                       value="@entry.FullyCompletedAt?.ToString("yyyy-MM-dd")" @onchange="e => SetFullyCompletedDateAsync(entry, e)"/>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <hr class="my-3"/>

            <div>
                <label class="form-label">Playthroughs</label>
                @if (entry.Playthroughs.Count == 0)
                {
                    <p class="kt-card-meta mb-2">No playthroughs recorded yet.</p>
                }
                @foreach (var playthrough in entry.Playthroughs)
                {
                    <div class="kt-playthrough-row mb-2">
                        <input class="form-control form-control-sm" placeholder="Label (e.g. NG+1)"
                               value="@playthrough.Label" @onchange="e => UpdatePlaythroughLabelAsync(playthrough, e)"/>
                        <input class="form-control form-control-sm" type="date"
                               value="@playthrough.CompletedAt?.ToString("yyyy-MM-dd")" @onchange="e => UpdatePlaythroughDateAsync(playthrough, e)"/>
                        <button class="kt-icon-btn" title="Remove this playthrough" aria-label="Remove this playthrough" @onclick="() => RemovePlaythroughAsync(entry, playthrough)">✕</button>
                    </div>
                }
                <button class="btn btn-sm btn-secondary" @onclick="() => AddPlaythroughAsync(entry)">+ Add playthrough</button>
            </div>
        </div>
    }

    @if (_draftPlatform is not null)
    {
        <div class="kt-form-card mb-3">
            <label class="form-label">Add a platform</label>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <select class="form-select form-select-sm" style="max-width:200px" @bind="_draftPlatform.Platform">
                    <option value="">— Platform —</option>
                    @foreach (var platform in VideoGames.VideoGamePlatforms)
                    {
                        <option>@platform</option>
                    }
                </select>
                <button class="btn btn-sm @(_draftPlatform.CopyType == CopyType.Physical ? "btn-primary" : "btn-secondary")" @onclick="() => _draftPlatform.CopyType = CopyType.Physical">Physical</button>
                <button class="btn btn-sm @(_draftPlatform.CopyType == CopyType.Digital ? "btn-primary" : "btn-secondary")" @onclick="() => _draftPlatform.CopyType = CopyType.Digital">Digital</button>
            </div>
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-sm btn-success" disabled="@string.IsNullOrEmpty(_draftPlatform.Platform)" @onclick="SaveDraftPlatformAsync">Save</button>
                <button class="btn btn-sm btn-secondary" @onclick="CancelDraftPlatform">Cancel</button>
            </div>
        </div>
    }
    else
    {
        <button class="btn btn-sm btn-secondary mb-3" @onclick="StartDraftPlatform">+ Add platform</button>
    }
    </div>
}

@code {
    [Inject] private VideoGameApiClient VideoGameApi { get; set; } = null!;

    [Inject] private ReferenceDataApiClient ReferenceDataApi { get; set; } = null!;

    protected override InventoryApiClientBase<VideoGameDto> Api => VideoGameApi;

    protected override VideoGameDto? Item { get => Game; set => Game = value; }

    protected override VideoGameReferenceDto? ItemReference { get => Reference; set => Reference = value; }

    protected override Task<VideoGameReferenceDto?> GetReferenceAsync(string referenceId) => ReferenceDataApi.GetVideoGameAsync(referenceId);

    // Public, as [PersistentState] requires: the prerendered item carries over to the interactive circuit instead of being fetched again.
    [PersistentState]
    public VideoGameDto? Game { get; set; }

    [PersistentState]
    public VideoGameReferenceDto? Reference { get; set; }

    // Reveals the cover-URL box.
    // An item that already carries a CustomImageUrl shows that box without this flag, so a stored value is never hidden behind a button.
    private bool _editingCover;
    private VideoGamePlatformDto? _draftPlatform;
    private VideoGamePlatformDto? _pendingRemovePlatform;

    private async Task SetRatingAsync(float rating)
    {
        if (Game is null) return;
        Game.Rating = rating;
        await SaveAsync();
    }

    private async Task ToggleWishlistedAsync()
    {
        if (Game is null) return;
        Game.IsWishlisted = !Game.IsWishlisted;
        await SaveAsync();
    }

    private async Task SaveTitleAsync(ChangeEventArgs e)
    {
        if (Game is null) return;
        var title = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(title)) return;
        Game.Title = title;
        await SaveAsync();
    }

    private async Task SaveYearAsync(ChangeEventArgs e)
    {
        if (Game is null) return;
        Game.Year = int.TryParse(e.Value?.ToString(), out var year) ? year : null;
        await SaveAsync();
    }

    private async Task SaveNotesAsync(ChangeEventArgs e)
    {
        if (Game is null) return;
        Game.Notes = e.Value?.ToString();
        await SaveAsync();
    }

    private async Task SaveCustomImageUrlAsync(ChangeEventArgs e)
    {
        if (Game is null) return;
        Game.CustomImageUrl = e.Value?.ToString();
        await SaveAsync();
    }

    private void StartDraftPlatform() => _draftPlatform = new VideoGamePlatformDto();

    private void CancelDraftPlatform() => _draftPlatform = null;

    private async Task SaveDraftPlatformAsync()
    {
        if (Game is null || _draftPlatform is null || string.IsNullOrEmpty(_draftPlatform.Platform)) return;
        Game.Platforms.Add(_draftPlatform);
        _draftPlatform = null;
        await SaveAsync();
    }

    private async Task RequestRemovePlatformAsync(VideoGamePlatformDto entry)
    {
        // a platform entry with no state/completion/playthroughs set has no details to lose -
        // remove it without the confirmation detour, same as OwnedVersionsEditor's empty-copy case
        if (IsEmpty(entry))
        {
            await RemovePlatformAsync(entry);
            return;
        }

        _pendingRemovePlatform = entry;
    }

    private async Task ConfirmRemovePlatformAsync()
    {
        var entry = _pendingRemovePlatform;
        _pendingRemovePlatform = null;
        if (entry is not null)
        {
            await RemovePlatformAsync(entry);
        }
    }

    private async Task RemovePlatformAsync(VideoGamePlatformDto entry)
    {
        if (Game is null) return;
        Game.Platforms.Remove(entry);
        await SaveAsync();
    }

    private static bool IsEmpty(VideoGamePlatformDto entry) =>
        string.IsNullOrWhiteSpace(entry.State)
        && !entry.IsFullyCompleted
        && entry.FullyCompletedAt is null
        && entry.Playthroughs.Count == 0
        && entry.Price is null
        && entry.AcquiredAt is null
        && string.IsNullOrWhiteSpace(entry.Vendor)
        && string.IsNullOrWhiteSpace(entry.Reference)
        && string.IsNullOrWhiteSpace(entry.ProductName);

    /// <summary>
    /// Clicking the already-active state button clears it back to unset - same toggle-off-on-reclick
    /// pattern as <c>TvShowDetail.razor</c>'s <c>SetStatusAsync</c>, now applied per platform entry.
    /// </summary>
    private async Task SetPlatformStateAsync(VideoGamePlatformDto entry, string state)
    {
        entry.State = entry.State == state ? "" : state;
        if (entry.State == "Completed") entry.CompletedAt ??= DateOnly.FromDateTime(DateTime.Today);
        await SaveAsync();
    }

    private async Task SetPlatformCompletedDateAsync(VideoGamePlatformDto entry, ChangeEventArgs e)
    {
        entry.CompletedAt = DateOnlyInput.Parse(e.Value);
        await SaveAsync();
    }

    private async Task SetPlatformProductNameAsync(VideoGamePlatformDto entry, ChangeEventArgs e)
    {
        entry.ProductName = e.Value?.ToString();
        await SaveAsync();
    }

    private async Task ToggleFullyCompletedAsync(VideoGamePlatformDto entry)
    {
        entry.IsFullyCompleted = !entry.IsFullyCompleted;
        entry.FullyCompletedAt = entry.IsFullyCompleted ? entry.FullyCompletedAt ?? DateOnly.FromDateTime(DateTime.Today) : null;
        await SaveAsync();
    }

    private async Task SetFullyCompletedDateAsync(VideoGamePlatformDto entry, ChangeEventArgs e)
    {
        entry.FullyCompletedAt = DateOnlyInput.Parse(e.Value);
        await SaveAsync();
    }

    private async Task AddPlaythroughAsync(VideoGamePlatformDto entry)
    {
        entry.Playthroughs.Add(new PlaythroughDto { Label = "" });
        await SaveAsync();
    }

    private async Task RemovePlaythroughAsync(VideoGamePlatformDto entry, PlaythroughDto playthrough)
    {
        entry.Playthroughs.Remove(playthrough);
        await SaveAsync();
    }

    private async Task UpdatePlaythroughLabelAsync(PlaythroughDto playthrough, ChangeEventArgs e)
    {
        playthrough.Label = e.Value?.ToString() ?? "";
        await SaveAsync();
    }

    private async Task UpdatePlaythroughDateAsync(PlaythroughDto playthrough, ChangeEventArgs e)
    {
        playthrough.CompletedAt = DateOnlyInput.Parse(e.Value);
        await SaveAsync();
    }

}
