@using static Keeptrack.BlazorApp.Components.Shared.SvgChartHelpers
@*
    A stacked bar chart of fuel and maintenance cost per month, each segment carrying a native tooltip with the exact figure.
    A thin gap separates the two segments of a bar so they read as two marks rather than one solid bar.
*@

<svg viewBox="0 0 @ToSvgDimension(Geometry.ViewWidth) @ToSvgDimension(Geometry.ViewHeight)" class="kt-chart-svg">
    <ChartAxes Geometry="Geometry" MarkerId="kt-chart-arrow-cost" XAxisLabel="Month" YAxisLabel="€" YTicks="YTicks" XTicks="XTicks"/>
    @for (var i = 0; i < Points.Count; i++)
    {
        var point = Points[i];
        var x = BarX(i);
        var fuelHeight = ScaleHeight(point.FuelCost);
        var maintenanceHeight = ScaleHeight(point.MaintenanceCost);
        var stackGap = point.FuelCost > 0 && point.MaintenanceCost > 0 ? 0.6 : 0;
        var maintenanceY = Geometry.PlotBottom - maintenanceHeight;
        var fuelY = maintenanceY - stackGap - fuelHeight;
        <rect x="@ToSvg(x)" y="@ToSvg(maintenanceY)" width="@ToSvg(_barWidth)" height="@ToSvg(maintenanceHeight)" fill="var(--kt-chart-secondary)">
            <title>@($"{point.Period:yyyy-MM}: maintenance {point.MaintenanceCost:F2}")</title>
        </rect>
        <rect x="@ToSvg(x)" y="@ToSvg(fuelY)" width="@ToSvg(_barWidth)" height="@ToSvg(fuelHeight)" fill="var(--kt-accent)">
            <title>@($"{point.Period:yyyy-MM}: fuel {point.FuelCost:F2}")</title>
        </rect>
    }
</svg>

@code {
    private static readonly ChartGeometry Geometry = FullWidthGeometry;

    [Parameter, EditorRequired] public List<CarCostHistoryPointDto> Points { get; set; } = [];

    private double _maxTotal;
    private double _barWidth;
    private double _gap;

    private List<(double, string)> YTicks { get; set; } = [];

    private List<(double, string)> XTicks { get; set; } = [];

    protected override void OnParametersSet()
    {
        _maxTotal = Points.Max(p => p.TotalCost);
        if (_maxTotal <= 0) _maxTotal = 1;
        var plotWidth = Geometry.PlotRight - Geometry.PlotLeft;
        _barWidth = plotWidth / Points.Count * 0.7;
        _gap = plotWidth / Points.Count * 0.3;

        YTicks = Enumerable.Range(0, 4).Select(i => _maxTotal * i / 3.0).Select(v => (Geometry.PlotBottom - ScaleHeight(v), v.ToString("F0"))).ToList();
        XTicks = EvenlySpacedIndices(Points.Count, 5).Select(i => (BarX(i) + _barWidth / 2, Points[i].Period.ToString("MMM yy"))).ToList();
    }

    private double BarX(int index) => Geometry.PlotLeft + index * (_barWidth + _gap);

    private double ScaleHeight(double value) => value / _maxTotal * (Geometry.PlotBottom - Geometry.PlotTop);
}
