@* Cover art and fields, side by side on desktop and stacked on a phone: the top of a media detail page.

   A Bootstrap `col-md-2` cover is 1/6 of the row, a ~130px poster on a wide card that reads as a thumbnail, with the fields stranded beside it.
   This component owns the single-column rule when there is no cover, the per-shape cover sizing and the stacking breakpoint.
   It renders the fields row itself, so a caller supplies only `col-*` children. *@

<div class="kt-detail-hero @Shape @(HasCover ? null : "kt-detail-hero-no-cover")">
    @if (HasCover)
    {
        @* The work's own artwork is informative, so it keeps a real alt text from the caller rather than an empty one. *@
        <img class="kt-detail-cover @Shape" src="@ImageUrl" alt="@Alt" loading="lazy"/>
    }
    <div class="row g-3 align-content-start">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>
    /// Cover URL: the tenant's own <c>CustomImageUrl</c> when set, otherwise the linked reference's.
    /// Null or empty collapses the hero to a single full-width fields column.
    /// </summary>
    [Parameter] public string? ImageUrl { get; set; }

    /// <summary>Unset for portrait (2:3 posters and book covers), <c>"square"</c> for album art.</summary>
    [Parameter] public string? Shape { get; set; }

    /// <summary>Alt text for the cover ("Heat poster").</summary>
    [Parameter] public string? Alt { get; set; }

    /// <summary>The fields, as Bootstrap <c>col-*</c> children, this component supplying the row.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool HasCover => !string.IsNullOrEmpty(ImageUrl);
}
