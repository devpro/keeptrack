@* Full add/edit form body for one health-journal entry (appointment/sickness/other) - shared between
   HealthProfileDetail's own journal modal and Quick Add's health-record form. Modal chrome, edit-mode
   detection and save/cancel behavior stay with each caller; this is only the fields. The balance rule
   itself stays authoritative in HealthMetricsService - MissingAmount here is only a live preview of the
   same arithmetic while typing. *@

<div class="row g-3">
    <div class="col-12">
        <label class="form-label d-block">Event type</label>
        <div class="d-flex gap-2 flex-wrap kt-btn-row-even">
            @foreach (var eventType in Enum.GetValues<HealthEventType>())
            {
                <button type="button" class="btn btn-sm @(Entry.EventType == eventType ? "btn-primary" : "btn-secondary")"
                        @onclick="() => Entry.EventType = eventType">@eventType</button>
            }
        </div>
    </div>
    <DateTimeFields @bind-Value="Entry.HistoryDate"/>
    @if (Entry.EventType == HealthEventType.Appointment)
    {
        @* Both fields are free text with a suggestion dropdown over what this account has already typed,
           the same shape as the car history form's fuel type: the same specialty and the same doctor come
           back visit after visit, and re-typing them is what lets "dentiste"/"Dentiste" drift apart.
           The list is fetched per account (see HealthRecordController.GetSuggestions) - a practitioner's
           name is not something to share between users the way a fuel grade is.
           InputCssClass: full-size, or these two render visibly shorter than every other field here. *@
        <div class="col-md-6">
            <label class="form-label">Specialty</label>
            @* data-testid: same for/id gotcha as Practitioner below *@
            <SuggestInput Value="@Entry.Specialty" ValueChanged="v => Entry.Specialty = v"
                          Suggestions="@_specialties" InputCssClass="form-control"
                          Placeholder="généraliste, dentiste, …" data-testid="specialty-input"/>
        </div>
        <div class="col-md-6">
            <label class="form-label">Practitioner</label>
            @* data-testid: the label/input pair has no for/id association, so GetByLabel
               can't resolve it in e2e tests - same as every inventory Add form *@
            @* More matches than the default 8: a household accumulates a practitioner per specialty per
               person, so a short list reads as "it doesn't know mine" - the StationPicker's reasoning. *@
            <SuggestInput Value="@Entry.Practitioner" ValueChanged="v => Entry.Practitioner = v"
                          Suggestions="@_practitioners" InputCssClass="form-control" MaxSuggestions="15"
                          Placeholder="Dr …" data-testid="practitioner-input"/>
        </div>
        <div class="col-md-3">
            <label class="form-label">Price paid (€)</label>
            <input class="form-control" type="number" step="0.01" data-testid="price-input" @bind="Entry.Price"/>
        </div>
        <div class="col-md-3">
            <label class="form-label">Public reimb. (€)</label>
            <input class="form-control" type="number" step="0.01" @bind="Entry.PublicReimbursement"
                   title="What the public health system (assurance maladie / ameli) officially reimburses for this care."/>
        </div>
        <div class="col-md-3">
            <label class="form-label">Insur. reimb. (€)</label>
            <input class="form-control" type="number" step="0.01" @bind="Entry.InsuranceReimbursement"/>
        </div>
        <div class="col-md-3">
            <label class="form-label">Not covered (€)</label>
            <input class="form-control" type="number" step="0.01" @bind="Entry.NotCovered"
                   title="Reste à charge: the accepted part no one will reimburse."/>
        </div>
        @if (Entry.Price is > 0)
        {
            var missing = MissingAmount;
            <div class="col-12">
                @if (Math.Abs(missing) <= 0.005)
                {
                    <span class="kt-card-meta" style="color:var(--kt-success)">✓ Balanced - paid, reimbursements and not-covered add up to zero.</span>
                }
                else
                {
                    <span class="kt-card-meta" style="color:var(--kt-warning)">
                        @missing.ToString("F2") € @(missing > 0 ? "still unaccounted for - this entry will appear under \"Reimbursements to check\"." : "received beyond the price - worth a look.")
                    </span>
                }
            </div>
        }
    }
    <div class="col-12">
        <label class="form-label">Description</label>
        <textarea class="form-control" rows="2" placeholder="@DescriptionPlaceholder" @bind="Entry.Description"></textarea>
    </div>
    <div class="col-12">
        <label class="form-label">Notes</label>
        <textarea class="form-control" rows="2" @bind="Entry.Notes"></textarea>
    </div>
</div>

@code {
    [Parameter] public required HealthRecordDto Entry { get; set; }

    [Inject] private HealthRecordApiClient HealthRecordApi { get; set; } = null!;

    private List<string> _specialties = [];
    private List<string> _practitioners = [];

    /// <summary>
    /// One call for both suggestion lists when the form opens - they're small, owner-scoped and shared by
    /// every field on the form, so nothing here costs a request per keystroke.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var suggestions = await HealthRecordApi.GetSuggestionsAsync();
        _specialties = suggestions.Specialties;
        _practitioners = suggestions.Practitioners;
    }

    /// <summary>Live preview of the same balance HealthMetricsService computes server-side.</summary>
    private double MissingAmount =>
        (Entry.Price ?? 0) - (Entry.PublicReimbursement ?? 0) - (Entry.InsuranceReimbursement ?? 0) - (Entry.NotCovered ?? 0);

    private string DescriptionPlaceholder => Entry.EventType == HealthEventType.Sickness
        ? "What was wrong (fever, migraine, gastro, …)"
        : "Reason for the visit / what happened";

    public static HealthRecordDto NewEntry(string profileId) => new()
    {
        HealthProfileId = profileId,
        // today at the current hour, minute zeroed - a "right now" default the time field can refine
        HistoryDate = DateTime.Today.AddHours(DateTime.Now.Hour),
        EventType = HealthEventType.Appointment
    };
}
