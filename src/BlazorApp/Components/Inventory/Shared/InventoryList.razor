@typeparam TDto where TDto : IHasId

@if (Error is not null)
{
    <div class="alert alert-danger mb-4" role="alert">@Error</div>
}

<ConfirmModal Show="_pendingDeleteId is not null"
              Title="Delete this item?"
              Message="@($"This will permanently delete this {ItemName ?? "item"}. This can't be undone.")"
              OnConfirm="ConfirmDeleteAsync" OnCancel="CancelDelete"/>

@if (!ReadOnly && ShowForm && FormTemplate is not null && Form is not null)
{
    <div class="kt-form-card">
        <h5>New @(ItemName ?? "item")</h5>
        <div class="row g-3">
            @FormTemplate(Form)
        </div>
        <div class="d-flex gap-2 mt-3 align-items-center">
            <button class="btn btn-success" @onclick="OnSave" disabled="@Matching">Save</button>
            <button class="btn btn-secondary" @onclick="OnCancelForm" disabled="@Matching">Cancel</button>
            @* The item is already saved by this point - this is the reference lookup the detail page would otherwise show popping in. *@
            @if (Matching)
            {
                <span class="kt-card-meta d-flex align-items-center gap-2">
                    <span class="kt-icon-spin"><Icon Name="refresh" Size="15"/></span> Looking for a match…
                </span>
            }
        </div>
    </div>
}

@if (!Loaded)
{
    @if (Loading)
    {
        <div class="kt-loading">
            <div class="kt-spinner"></div>
            Loading…
        </div>
    }
}
else
{
    @* List view caps its measure (see .kt-table-wrap-list); the grid keeps the full width, which is what
       lets it fit another column of cover art per row. *@
    <div class="kt-table-wrap @(IsGridView ? "" : "kt-table-wrap-list")">
        <div class="kt-table-header">
            <h1 class="kt-table-title">@if (!ReadOnly){<text>My </text>}<span>@Title</span></h1>
            @if (!ReadOnly && !ShowForm)
            {
                <button class="btn btn-primary" @onclick="OnShowAddForm">+ Add</button>
            }
        </div>
        <div class="kt-search-bar">
            <div class="kt-search-input-wrap">
                <input class="form-control" type="search" placeholder="Search…"
                       @bind="_localSearch" @bind:event="oninput"
                       @onkeyup="HandleSearchKeyUp"/>
                <span class="kt-search-icon"><Icon Name="search" Size="15"/></span>
            </div>
            @* Everything that isn't the search box shares one row. On a phone the search box takes the
               full width and this row scrolls sideways rather than wrapping, so the toolbar costs two
               rows instead of three - roughly 90px back above the first item on an 844px screen, with
               nothing hidden behind a "filters" button. *@
            <div class="kt-search-controls">
            @if (!string.IsNullOrEmpty(_localSearch))
            {
                <button class="btn btn-secondary btn-sm" @onclick="HandleClear">Clear</button>
            }
            <select class="form-select form-select-sm kt-sort-select" title="Sort by" aria-label="Sort by"
                    value="@Sort" @onchange="e => OnSortChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)">
                <option value="">Added</option>
                <option value="@ListSort.Title">A–Z</option>
                @if (HasRatingSort)
                {
                    <option value="@ListSort.Rating">Rating</option>
                }
                @if (HasReferenceRatingSort)
                {
                    @* short label so the selected text fits the narrow (mobile-sized) sort control *@
                    <option value="@ListSort.ReferenceRating">Ref ★</option>
                }
                @if (ExtraSortValue is not null)
                {
                    <option value="@ExtraSortValue">@ExtraSortLabel</option>
                }
            </select>
            @if (ItemImageUrl is not null)
            {
                @* Grid view leverages cover art, so the toggle only appears for types that have it. *@
                <ListViewToggle View="@View" ViewChanged="@OnViewChanged"/>
            }
            @if (Filters is not null)
            {
                <div class="kt-search-filters">@Filters</div>
            }
            </div>
        </div>
        @if (Items.Count > 0)
        {
            @if (IsGridView)
            {
                @* Poster/thumbnail view: the cover art is the hero, with title + meta captioned underneath.
                   Same stretched-link-opens-detail / delete-button-above-via-z-index model as the list rows. *@
                <div class="kt-item-grid @ItemImageShape">
                    @foreach (var item in Items)
                    {
                        <ItemGridCard Href="@(ReadOnly ? DetailHref?.Invoke(item) : $"{Route}/{item.Id}")" Title="@ItemTitle(item)"
                                      ImageUrl="@ItemImageUrl!(item)" Shape="@ItemImageShape">
                            <Actions>
                                @if (ReadOnly)
                                {
                                    @RowActions?.Invoke(item)
                                }
                                else
                                {
                                    <button type="button" class="kt-icon-btn kt-grid-delete" title="Delete" aria-label="Delete"
                                            @onclick="() => RequestDelete(item)">
                                        <Icon Name="trash" Size="15"/>
                                    </button>
                                }
                            </Actions>
                            <MetaContent>@MetaTemplate(item)</MetaContent>
                        </ItemGridCard>
                    }
                </div>
            }
            else
            {
                <div class="kt-item-list">
                    @foreach (var item in Items)
                    {
                        @* The stretched-link title makes the whole row open the detail page (where all editing
                           happens); the delete button sits above it via z-index. *@
                        <div class="kt-item-row">
                            @if (ItemImageUrl is not null)
                            {
                                <ItemThumb ImageUrl="@ItemImageUrl(item)" Title="@ItemTitle(item)" Shape="@ItemImageShape"/>
                            }
                            <div class="kt-item-main">
                                @if (!ReadOnly)
                                {
                                    <a class="kt-item-title stretched-link" href="@($"{Route}/{item.Id}")">@ItemTitle(item)</a>
                                }
                                else if (DetailHref is not null)
                                {
                                    @* Read-only but navigable: personal shared items (cars/houses/health) open a full
                                       read-only detail page, unlike media shared rows which don't link anywhere. *@
                                    <a class="kt-item-title stretched-link" href="@DetailHref(item)">@ItemTitle(item)</a>
                                }
                                else
                                {
                                    <span class="kt-item-title">@ItemTitle(item)</span>
                                }
                                <div class="kt-item-meta">@MetaTemplate(item)</div>
                            </div>
                            @if (ReadOnly)
                            {
                                @RowActions?.Invoke(item)
                            }
                            else
                            {
                                <button type="button" class="kt-icon-btn kt-item-delete" title="Delete" aria-label="Delete"
                                        @onclick="() => RequestDelete(item)">
                                    <Icon Name="trash" Size="15"/>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="kt-empty">
                <div class="kt-empty-icon"><Icon Name="empty" Size="40" StrokeWidth="1.1"/></div>
                <p>@(EmptyText ?? "Your collection is empty.")</p>
            </div>
        }

        @if (TotalPages > 1)
        {
            <div class="kt-pagination">
                <button class="kt-page-btn" disabled="@(Page == 1)"
                        @onclick="() => OnGoToPage.InvokeAsync(1)"><Icon Name="first" Size="14"/>
                </button>
                <button class="kt-page-btn" disabled="@(Page == 1)"
                        @onclick="() => OnGoToPage.InvokeAsync(Page - 1)"><Icon Name="previous" Size="14"/>
                </button>
                @{
                    int start, end;
                    if (TotalPages <= 3)
                    {
                        start = 1;
                        end = TotalPages;
                    }
                    else if (Page <= 2)
                    {
                        start = 1;
                        end = 3;
                    }
                    else if (Page >= TotalPages - 1)
                    {
                        start = TotalPages - 2;
                        end = TotalPages;
                    }
                    else
                    {
                        start = Page - 1;
                        end = Page + 1;
                    }
                }
                @for (var p = start; p <= end; p++)
                {
                    var pageNum = p;
                    <button class="kt-page-btn @(pageNum == Page ? "active" : "")"
                            @onclick="() => OnGoToPage.InvokeAsync(pageNum)">@pageNum</button>
                }
                <button class="kt-page-btn" disabled="@(Page == TotalPages)"
                        @onclick="() => OnGoToPage.InvokeAsync(Page + 1)"><Icon Name="next" Size="14"/>
                </button>
                <button class="kt-page-btn" disabled="@(Page == TotalPages)"
                        @onclick="() => OnGoToPage.InvokeAsync(TotalPages)"><Icon Name="last" Size="14"/>
                </button>
                <span class="kt-page-info">@TotalCount results</span>
            </div>
        }
    </div>
}

@code {
    /// <summary>
    /// Whether the poster/thumbnail grid renders rather than the media rows - the caller can ask for "grid"
    /// on a type that has no cover art to show, which still falls back to rows. Read by both the layout
    /// itself and the width cap on the wrapper, so the condition is stated once.
    /// <para>
    /// Its <see cref="ItemImageUrl"/> null check is invisible to flow analysis behind this property, which
    /// is why the grid branch dereferences it with <c>!</c> - guarded by this, never actually null there.
    /// </para>
    /// </summary>
    private bool IsGridView => View == "grid" && ItemImageUrl is not null;

    private string? _pendingDeleteId;
    private string _localSearch = "";
    private string _lastSearchParam = "";
    private string _lastSearchSent = "";

    // Adopt an externally-changed Search parameter (URL navigation, browser back/forward) into the
    // input without clobbering in-progress typing: a value we reported ourselves via OnSearchChanged
    // comes straight back as an equal parameter and must be ignored, or a re-render racing fast
    // typing would revert characters entered since the last keyup.
    protected override void OnParametersSet()
    {
        if (Search == _lastSearchParam) return;
        _lastSearchParam = Search;
        if (Search != _lastSearchSent)
        {
            _localSearch = Search;
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        _lastSearchSent = _localSearch;
        await OnSearchChanged.InvokeAsync(_localSearch);
        await OnSearchKeyUp.InvokeAsync(e);
    }

    private async Task HandleClear()
    {
        _localSearch = "";
        _lastSearchSent = "";
        await OnSearchChanged.InvokeAsync("");
        await OnClearSearch.InvokeAsync();
    }

    private void RequestDelete(TDto item) => _pendingDeleteId = item.Id;

    private void CancelDelete() => _pendingDeleteId = null;

    private async Task ConfirmDeleteAsync()
    {
        var id = _pendingDeleteId;
        _pendingDeleteId = null;
        if (id is not null) await OnDelete.InvokeAsync(id);
    }

    [Parameter] public required string Title { get; set; }
    [Parameter] public string? ItemName { get; set; }
    [Parameter] public required List<TDto> Items { get; set; }
    [Parameter] public required bool Loading { get; set; }

    /// <summary>
    /// Read-only mode: no "My" title prefix, no Add form/button, no per-row delete, and rows don't link to a
    /// detail page. Used by the shared-collection view - a recipient browses someone else's items and can't
    /// edit them, only <see cref="RowActions"/> (an "add to my collection" affordance).
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Per-row action rendered in place of the delete button when <see cref="ReadOnly"/> - the shared view
    /// puts its add-to-collection icon here. Ignored unless <see cref="ReadOnly"/>.
    /// </summary>
    [Parameter] public RenderFragment<TDto>? RowActions { get; set; }

    /// <summary>
    /// Read-only detail route selector. When set (only meaningful with <see cref="ReadOnly"/>), each row/card
    /// links to it - used by the shared personal categories (cars/houses/health), which do have a full
    /// read-only detail page. Left unset by the media shared list, whose rows don't navigate anywhere.
    /// </summary>
    [Parameter] public Func<TDto, string?>? DetailHref { get; set; }

    /// <summary>Empty-state message; defaults to the owner-facing "Your collection is empty."</summary>
    [Parameter] public string? EmptyText { get; set; }

    // Add-form inputs, only used in the editable (owner) mode - optional so a read-only caller omits them.
    [Parameter] public TDto? Form { get; set; }

    /// <summary>
    /// True once a load attempt (fresh or restored from persisted prerender state) has finished, found
    /// or not - distinct from <see cref="Loading"/>, which is delay-gated and only turns on for a load
    /// that's genuinely slow. Before this is true, nothing renders except a delayed <see cref="Loading"/>
    /// spinner, so the forced render Blazor triggers right after the synchronous prefix of
    /// OnParametersSetAsync (before any awaited fetch resolves) shows blank instead of a flash of the
    /// empty-collection state. Defaults true so a hypothetical caller that never sets it renders as before.
    /// </summary>
    [Parameter] public bool Loaded { get; set; } = true;
    [Parameter] public bool ShowForm { get; set; }
    [Parameter] public required string? Error { get; set; }
    [Parameter] public required string Search { get; set; }

    /// <summary>Current sort key ("" = the newest-first default) - see <see cref="ListSort"/>.</summary>
    [Parameter] public required string Sort { get; set; }

    /// <summary>Current display mode ("" = detailed list, "grid" = poster thumbnails).</summary>
    [Parameter] public string View { get; set; } = "";

    /// <summary>Offers the "Rating" sort option - only for types that carry a rating field.</summary>
    [Parameter] public bool HasRatingSort { get; set; }

    /// <summary>
    /// Offers the "Reference rating" sort option (the linked reference's provider score) - only for the
    /// reference-bearing types that denormalize it onto the tenant item.
    /// </summary>
    [Parameter] public bool HasReferenceRatingSort { get; set; }

    /// <summary>
    /// Query value for an extra, type-specific sort option (e.g. Movie's "seen", Book's "read", Video
    /// Game's "completed") - unset means no extra option renders. Paired with <see cref="ExtraSortLabel"/>.
    /// </summary>
    [Parameter] public string? ExtraSortValue { get; set; }

    [Parameter] public string? ExtraSortLabel { get; set; }
    [Parameter] public required int Page { get; set; }
    [Parameter] public required int TotalPages { get; set; }
    [Parameter] public required long TotalCount { get; set; }

    /// <summary>The list's own route ("/movies"), also every row link's detail-route prefix.</summary>
    [Parameter] public required string Route { get; set; }

    [Parameter] public required Func<TDto, string?> ItemTitle { get; set; }

    /// <summary>
    /// Cover/poster URL selector - leave unset for types with no reference imagery (cars, houses,
    /// playlists), which then render without a thumbnail column at all.
    /// </summary>
    [Parameter] public Func<TDto, string?>? ItemImageUrl { get; set; }

    /// <summary>See <see cref="ItemThumb.Shape"/>: unset = portrait, "square" (albums), "wide" (games).</summary>
    [Parameter] public string? ItemImageShape { get; set; }

    /// <summary>
    /// The row's second line: year/creator text and .kt-flag-badge pills. This is per-type data shape,
    /// not layout - rows themselves render identically for every type.
    /// </summary>
    [Parameter] public required RenderFragment<TDto> MetaTemplate { get; set; }

    // Add-form/delete callbacks, only used in the editable (owner) mode - a default EventCallback is a safe
    // no-op, so a read-only caller simply omits them.
    [Parameter] public RenderFragment<TDto>? FormTemplate { get; set; }
    [Parameter] public RenderFragment? Filters { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    /// <summary>Whether the just-saved item is still being matched to reference data, so the form stays put instead of opening a detail page that would fill itself in a moment later.</summary>
    [Parameter] public bool Matching { get; set; }
    [Parameter] public EventCallback OnCancelForm { get; set; }
    [Parameter] public EventCallback OnShowAddForm { get; set; }
    [Parameter] public required EventCallback OnClearSearch { get; set; }
    [Parameter] public required EventCallback<KeyboardEventArgs> OnSearchKeyUp { get; set; }
    [Parameter] public required EventCallback<int> OnGoToPage { get; set; }
    [Parameter] public EventCallback<string> OnDelete { get; set; }
    [Parameter] public required EventCallback<string> OnSearchChanged { get; set; }
    [Parameter] public required EventCallback<string> OnSortChanged { get; set; }
    [Parameter] public EventCallback<string> OnViewChanged { get; set; }
}
