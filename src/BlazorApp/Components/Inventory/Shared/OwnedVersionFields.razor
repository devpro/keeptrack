@using System.Globalization
@inject UserPreferencesState PreferencesState

@* The shared owned-copy fields (Physical or Digital toggle, price, acquired date, vendor, reference).
   Used by OwnedVersionsEditor.razor (movie, TV show, book, album), VideoGameDetail.razor's platform cards, and Quick Add's owned-copy toggle.
   Each caller keeps its own persistence timing (draft Save button, auto-save, nothing until Save) through OnChanged, a no-op by default.
   ButtonRowSuffix renders beside the Physical and Digital buttons (a caller's remove icon), so a caller's header needn't be split around this component.
   ExtraFields renders as one more column in the field row (VideoGamePlatformDto.ProductName), a slot rather than an IOwnedCopyDto member, since no other caller has one.
   The four columns below use unnumbered col-md (equal-width auto layout) rather than col-md-3 for that reason.
   Without ExtraFields they fill one row like a 3/3/3/3 split, and a fifth column joins the same row and re-shares the width instead of wrapping. *@

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div class="d-flex gap-2">
        <button class="btn btn-sm @(Copy.CopyType == CopyType.Physical ? "btn-primary" : "btn-secondary")" @onclick="() => SetCopyTypeAsync(CopyType.Physical)">Physical</button>
        <button class="btn btn-sm @(Copy.CopyType == CopyType.Digital ? "btn-primary" : "btn-secondary")" @onclick="() => SetCopyTypeAsync(CopyType.Digital)">Digital</button>
    </div>
    @ButtonRowSuffix
</div>
<div class="row g-3 mt-0">
    @* the euro sign is a display choice, not stored data, so a per-user currency setting can replace it *@
    <div class="col-6 col-md">
        <label class="form-label">Price (€)</label>
        <input class="form-control form-control-sm" type="number" step="0.01" min="0" data-testid="version-price-input"
               value="@Copy.Price?.ToString(CultureInfo.InvariantCulture)" @onchange="SetPriceAsync"/>
    </div>
    <div class="col-6 col-md">
        <label class="form-label">Acquired on</label>
        <input class="form-control form-control-sm" type="date" data-testid="version-acquired-input"
               value="@Copy.AcquiredAt?.ToString("yyyy-MM-dd")" @onchange="SetAcquiredAtAsync"/>
    </div>
    <div class="col-6 col-md">
        <label class="form-label">Vendor</label>
        <input class="form-control form-control-sm" placeholder="Store, site, seller…" data-testid="version-vendor-input"
               value="@Copy.Vendor" @onchange="SetVendorAsync"/>
    </div>
    <div class="col-6 col-md">
        <label class="form-label">Reference</label>
        @* align-items-start, not center: the optional Amazon link is a taller (2.25rem) .kt-icon-btn,
           and centring would push this input a few px below the Price, Acquired and Vendor inputs. *@
        <div class="d-flex gap-2 align-items-start">
            <input class="form-control form-control-sm" placeholder="Edition, order number…" data-testid="version-reference-input"
                   value="@Copy.Reference" @onchange="SetReferenceAsync"/>
            @if (_showAmazonProductLink && AmazonReference.TryExtractAsin(Copy.Reference) is { } asin)
            {
                <a class="kt-icon-btn" href="@AmazonReference.BuildProductUrl(asin, Copy.Vendor)"
                   target="_blank" rel="noopener noreferrer" title="Open on Amazon">
                    <Icon Name="external-link" Size="15"/>
                </a>
            }
        </div>
    </div>
    @ExtraFields
</div>

@code {
    [Parameter] public required IOwnedCopyDto Copy { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    [Parameter] public RenderFragment? ButtonRowSuffix { get; set; }

    [Parameter] public RenderFragment? ExtraFields { get; set; }

    private bool _showAmazonProductLink;

    protected override async Task OnInitializedAsync()
    {
        _showAmazonProductLink = (await PreferencesState.GetAsync()).Features.ShowAmazonProductLink;
    }

    private Task SetCopyTypeAsync(CopyType copyType)
    {
        Copy.CopyType = copyType;
        return OnChanged.InvokeAsync();
    }

    // number inputs report invariant-formatted values regardless of UI culture, so parse them the same way
    private Task SetPriceAsync(ChangeEventArgs e)
    {
        Copy.Price = decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var price) ? price : null;
        return OnChanged.InvokeAsync();
    }

    private Task SetVendorAsync(ChangeEventArgs e)
    {
        Copy.Vendor = e.Value?.ToString();
        return OnChanged.InvokeAsync();
    }

    private Task SetAcquiredAtAsync(ChangeEventArgs e)
    {
        Copy.AcquiredAt = DateOnlyInput.Parse(e.Value);
        return OnChanged.InvokeAsync();
    }

    private Task SetReferenceAsync(ChangeEventArgs e)
    {
        Copy.Reference = e.Value?.ToString();
        return OnChanged.InvokeAsync();
    }
}
