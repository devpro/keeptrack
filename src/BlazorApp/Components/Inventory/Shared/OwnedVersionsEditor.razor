@* The shared ownership section of the movie, TV show, book and album detail pages: one card per owned copy.
   An item is owned exactly when this list is non-empty, with no separate owned flag.
   Video games don't use it, since their per-platform entries are their copies.

   A new copy is a draft card with explicit Save and Cancel, like the list pages' Add form: nothing persists, and the item isn't owned, until Save.
   A saved copy's fields auto-save on change like every other detail field.
   Removing a saved copy asks for confirmation, since it discards price, date and vendor, except for an entirely empty copy, which goes in one click. *@

<h2 class="kt-section-title">Ownership</h2>

<ConfirmModal Show="_pendingRemove is not null"
              Title="Remove this copy?"
              Message="This will remove this copy and its details (price, date, vendor). This can't be undone."
              ConfirmLabel="Remove"
              OnConfirm="ConfirmRemoveAsync" OnCancel="() => _pendingRemove = null"/>

@if (Versions.Count == 0 && _draft is null)
{
    <p class="kt-card-meta">No owned copy recorded - add one below if you own this.</p>
}

@foreach (var version in DisplayedVersions)
{
    var isDraft = ReferenceEquals(version, _draft);
    @* kt-copy-card, since OwnedVersionFields' equal-width col-md columns re-share whatever room they get, opting out of .kt-form-card's width cap. *@
    <div class="kt-form-card kt-copy-card mb-3">
        <OwnedVersionFields Copy="version" OnChanged="() => NotifyChangedAsync(version)">
            <ButtonRowSuffix>
                @if (!isDraft)
                {
                    <button class="kt-icon-btn" title="Remove this copy" aria-label="Remove this copy" @onclick="() => RequestRemoveAsync(version)">
                        <Icon Name="trash" Size="15"/>
                    </button>
                }
            </ButtonRowSuffix>
            <ExtraFields>
                <div class="col-6 col-md">
                    <label class="form-label">Product</label>
                    <input class="form-control form-control-sm" placeholder="Store product/edition name…"
                           value="@version.ProductName" @onchange="e => SetProductNameAsync(version, e)"/>
                </div>
            </ExtraFields>
        </OwnedVersionFields>
        @if (isDraft)
        {
            <div class="d-flex gap-2 mt-3">
                <button class="btn btn-sm btn-success" data-testid="version-save-button" @onclick="SaveDraftAsync">Save</button>
                <button class="btn btn-sm btn-secondary" @onclick="CancelDraft">Cancel</button>
            </div>
        }
    </div>
}

@if (_draft is null)
{
    <button class="btn btn-sm btn-secondary mb-3" @onclick="StartDraft">+ Add version</button>
}

@code {
    /// <summary>The item's owned versions, mutated in place, the parent owning persistence.</summary>
    [Parameter] public required List<OwnedVersionDto> Versions { get; set; }

    /// <summary>Raised after every mutation, the parent saving the whole DTO like every detail page.</summary>
    [Parameter] public required EventCallback OnChanged { get; set; }

    private OwnedVersionDto? _draft;

    private OwnedVersionDto? _pendingRemove;

    /// <summary>The saved copies plus the in-progress draft (rendered as one more card, never persisted).</summary>
    private IEnumerable<OwnedVersionDto> DisplayedVersions => _draft is null ? Versions : Versions.Append(_draft);

    private void StartDraft() => _draft = new OwnedVersionDto();

    private void CancelDraft() => _draft = null;

    private async Task SaveDraftAsync()
    {
        if (_draft is null)
        {
            return;
        }

        Versions.Add(_draft);
        _draft = null;
        await OnChanged.InvokeAsync();
    }

    private async Task RequestRemoveAsync(OwnedVersionDto version)
    {
        // an entirely empty copy has nothing to lose, so it goes without confirmation
        if (IsEmpty(version))
        {
            await RemoveAsync(version);
            return;
        }

        _pendingRemove = version;
    }

    private async Task ConfirmRemoveAsync()
    {
        var version = _pendingRemove;
        _pendingRemove = null;
        if (version is not null)
        {
            await RemoveAsync(version);
        }
    }

    private async Task RemoveAsync(OwnedVersionDto version)
    {
        Versions.Remove(version);
        await OnChanged.InvokeAsync();
    }

    private static bool IsEmpty(OwnedVersionDto version) =>
        version.Price is null
        && version.AcquiredAt is null
        && string.IsNullOrWhiteSpace(version.Vendor)
        && string.IsNullOrWhiteSpace(version.Reference)
        && string.IsNullOrWhiteSpace(version.ProductName);

    private async Task SetProductNameAsync(OwnedVersionDto version, ChangeEventArgs e)
    {
        version.ProductName = e.Value?.ToString();
        await NotifyChangedAsync(version);
    }

    /// <summary>Saves after a mutation on a saved copy, while a draft's edits stay local until its Save button.</summary>
    private async Task NotifyChangedAsync(OwnedVersionDto version)
    {
        if (!ReferenceEquals(version, _draft))
        {
            await OnChanged.InvokeAsync();
        }
    }
}
