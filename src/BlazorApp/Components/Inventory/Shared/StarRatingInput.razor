<div class="d-flex align-items-center gap-2">
    <div class="kt-stars"><StarRating Rating="Rating"/></div>
    <input type="number" step="0.1" min="0" max="5" class="form-control form-control-sm" style="width:70px"
           value="@Rating" @onchange="HandleChangeAsync"/>
</div>

@code {
    /// <summary>
    /// The stars are an accurate live preview (see StarRating's percentage fill), but a click expresses only a few fixed positions, far from a rating like 4.8.
    /// The number field next to them is the editing surface.
    /// </summary>
    [Parameter] public float? Rating { get; set; }

    [Parameter] public EventCallback<float> RatingChanged { get; set; }

    private async Task HandleChangeAsync(ChangeEventArgs e)
    {
        if (float.TryParse(e.Value?.ToString(), out var value))
        {
            await RatingChanged.InvokeAsync(MathF.Round(Math.Clamp(value, 0, 5), 1));
        }
    }
}
