@implements IDisposable

<div class="top-row">
    <a class="navbar-brand" href="">Keeptrack</a>
    <label class="navbar-toggler-label" for="nav-toggle"><Icon Name="menu" Size="19"/></label>
</div>

<input type="checkbox" id="nav-toggle" @bind="_menuOpen" />

<div class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon"><Icon Name="home"/></span> Home
            </NavLink>
        </div>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="add">
                        <span class="nav-icon"><Icon Name="add"/></span> Quick add
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="watch-next">
                        <span class="nav-icon"><Icon Name="watch-next"/></span> Watch next
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="wishlist">
                        <span class="nav-icon"><Icon Name="wishlist"/></span> Wishlist
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="explore">
                        <span class="nav-icon"><Icon Name="explore"/></span> Explore
                    </NavLink>
                </div>
                @* Three labels group the rows by purpose: a place to look at everything (above), one collection type (here), account-level tools (below). *@
                <div class="kt-nav-group">Collection</div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="movies">
                        <span class="nav-icon"><Icon Name="movies"/></span> Movies
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="tv-shows">
                        <span class="nav-icon"><Icon Name="tv-shows"/></span> TV shows
                    </NavLink>
                </div>
                @* Free preview accounts (no Firebase "member" or "admin" role) get only movies and TV shows, whose links sit outside this block.
                   Hiding is UX, not security, since the API enforces the same policy on every request. *@
                <AuthorizeView Policy="MemberOnly" Context="memberContext">
                    <Authorized>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="books">
                                <span class="nav-icon"><Icon Name="books"/></span> Books
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="albums">
                                <span class="nav-icon"><Icon Name="albums"/></span> Albums
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="playlists">
                                <span class="nav-icon"><Icon Name="playlists"/></span> Playlists
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="video-games">
                                <span class="nav-icon"><Icon Name="video-games"/></span> Video games
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="cars">
                                <span class="nav-icon"><Icon Name="cars"/></span> Cars
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="houses">
                                <span class="nav-icon"><Icon Name="houses"/></span> Houses
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="health">
                                <span class="nav-icon"><Icon Name="health"/></span> Health
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="collectibles">
                                <span class="nav-icon"><Icon Name="collectibles"/></span> Collectibles
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="gear">
                                <span class="nav-icon"><Icon Name="gear"/></span> Gear
                            </NavLink>
                        </div>
                        @* Import opens the "Manage" group, which the admin-only rows below join when present.
                           Inside MemberOnly, since a free preview account has none of these rows and must not see a label heading an empty group. *@
                        <div class="kt-nav-group">Manage</div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="import">
                                <span class="nav-icon"><Icon Name="import"/></span> Import
                            </NavLink>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="nav-item">
                            <span class="kt-nav-note">Preview account - movies &amp; TV shows. A membership unlocks books, albums, games and more.</span>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
                <AuthorizeView Policy="AdminOnly" Context="adminContext">
                    <Authorized>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="admin/reference-data">
                                <span class="nav-icon"><Icon Name="admin"/></span> Admin
                            </NavLink>
                        </div>
                        <div class="nav-item">
                            <NavLink class="nav-link" href="admin/car-stations">
                                <span class="nav-icon"><Icon Name="stations"/></span> Stations
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <div class="nav-divider"></div>
                <div class="nav-item">
                    @* Prefix match so every /account/manage/* page (profile, sharing, shared-with-me) keeps this item current. *@
                    <NavLink class="nav-link nav-link-user" href="account/manage" Match="NavLinkMatch.Prefix">
                        <span class="nav-icon kt-nav-avatar">@(GetInitial(context.User.Identity?.Name))</span>
                        <span class="nav-username">@context.User.Identity?.Name</span>
                    </NavLink>
                </div>
                <div class="nav-item">
                    <a class="nav-link nav-link-logout" href="/auth/logout">
                        <span class="nav-icon"><Icon Name="logout"/></span> Log out
                    </a>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item">
                    <a class="nav-link" href="/account/login" data-enhance-nav="false">
                        <span class="nav-icon"><Icon Name="signin"/></span> Sign in
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    // The mobile menu is a pure-CSS checkbox toggle (see app.css's #nav-toggle:checked rule), and this is the one Blazor state, to close it after a nav-link click.
    // Interactive pages navigate through the circuit's router, not a DOM event, so NavigationManager.LocationChanged drives it, firing whichever navigation path Blazor takes.
    private bool _menuOpen;

    protected override void OnInitialized() => Navigation.LocationChanged += CloseMenu;

    private void CloseMenu(object? sender, LocationChangedEventArgs e)
    {
        if (!_menuOpen) return;
        _menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= CloseMenu;

    private static string GetInitial(string? name) =>
        string.IsNullOrEmpty(name) ? "" : name[..1].ToUpperInvariant();
}
