@page "/"
@inject StatsApiClient StatsApi
@inject NavigationManager Navigation

<PageTitle>Keeptrack</PageTitle>

@if (IsStillTheCurrentPage)
{
    <div class="kt-home">
        <AuthorizeView>
            <Authorized>
                <div class="kt-home-eyebrow">Your personal collection</div>
                @if (!_loaded)
                {
                    @if (_loading)
                    {
                        <div class="kt-loading">
                            <div class="kt-spinner"></div>
                            Loading…
                        </div>
                    }
                }
                else if (Stats is not null && TotalItems > 0)
                {
                    <h1>Welcome back —<br/><em>@TotalItems.ToString("N0") things remembered.</em></h1>
                    <p class="kt-home-sub">
                        Good work building this up@(Stats.EpisodesWatched > 0 ? $" — including {Stats.EpisodesWatched:N0} episodes watched across your shows" : "").
                        Every entry below is one more thing you'll never lose.
                    </p>
                    <div class="kt-stat-grid">
                        <a class="kt-stat-tile" href="/movies"><span class="kt-stat-value">@Stats.Movies</span><span class="kt-stat-label">Movies</span></a>
                        <a class="kt-stat-tile" href="/tv-shows"><span class="kt-stat-value">@Stats.TvShows</span><span class="kt-stat-label">TV shows</span></a>
                        <a class="kt-stat-tile" href="/books"><span class="kt-stat-value">@Stats.Books</span><span class="kt-stat-label">Books</span></a>
                        <a class="kt-stat-tile" href="/albums"><span class="kt-stat-value">@Stats.Albums</span><span class="kt-stat-label">Albums</span></a>
                        <a class="kt-stat-tile" href="/video-games"><span class="kt-stat-value">@Stats.VideoGames</span><span class="kt-stat-label">Video games</span></a>
                        <a class="kt-stat-tile" href="/playlists"><span class="kt-stat-value">@Stats.Playlists</span><span class="kt-stat-label">Playlists</span></a>
                        <a class="kt-stat-tile" href="/cars"><span class="kt-stat-value">@Stats.Cars</span><span class="kt-stat-label">Cars</span></a>
                        <a class="kt-stat-tile" href="/houses"><span class="kt-stat-value">@Stats.Houses</span><span class="kt-stat-label">Houses</span></a>
                        <a class="kt-stat-tile" href="/collectibles"><span class="kt-stat-value">@Stats.Collectibles</span><span class="kt-stat-label">Collectibles</span></a>
                        <a class="kt-stat-tile" href="/gear"><span class="kt-stat-value">@Stats.Gear</span><span class="kt-stat-label">Gear</span></a>
                    </div>
                }
                else
                {
                    <h1>Everything you do,<br/><em>remembered.</em></h1>
                    <p class="kt-home-sub">
                        Your collection is waiting for its first entry - log a film watched, a book read, an album on repeat.
                        Rate it, note it, never lose it.
                    </p>
                    <div class="kt-home-cta">
                        <a class="btn btn-primary" href="/add">+ Quick add</a>
                        <a class="btn btn-secondary" href="/movies">Go to my movies</a>
                    </div>
                }
            </Authorized>
            <NotAuthorized>
                <div class="kt-home-eyebrow">Your personal collection</div>
                <h1>Everything you do,<br/><em>remembered.</em></h1>
                <p class="kt-home-sub">
                    Keeptrack is your quiet space to log the things that matter - films watched, books read, places visited, habits tracked.
                    Rate them, note them, never lose them.
                </p>

                <div class="kt-home-features">
                    <span class="kt-home-feature"><Icon Name="movies" Size="13"/> Movies</span>
                    <span class="kt-home-feature"><Icon Name="tv-shows" Size="13"/> TV shows</span>
                    <span class="kt-home-feature"><Icon Name="books" Size="13"/> Books</span>
                    <span class="kt-home-feature"><Icon Name="cars" Size="13"/> Refuelling</span>
                    <span class="kt-home-feature">+ more</span>
                </div>

                <div class="kt-home-cta">
                    <a class="btn btn-primary" href="/account/login" data-enhance-nav="false">Get started</a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    // A public property, as [PersistentState] requires: the stats fetched during prerender carry over to the interactive circuit, which reuses them rather than re-fetching.
    // CollectionStatsDto is a handful of counts, well within the Blazor hub's 32 KB message limit,
    // so it follows the detail pages rather than Watch Next and Wishlist's re-fetch (see docs/blazor-ui.md).
    [PersistentState]
    public CollectionStatsDto? Stats { get; set; }

    // _loading is delay-gated (see LoadingIndicator) and turns on only for a slow load, and _loaded tracks whether a load has finished, fresh or restored from prerender state.
    // Both default false, so the render Blazor forces after OnInitializedAsync's synchronous prefix shows blank instead of the "no items yet" call to action.
    // A null Stats can't gate that frame, being indistinguishable from an empty, freshly loaded account.
    private bool _loading;
    private bool _loaded;

    private long TotalItems =>
        Stats is null
            ? 0
            : Stats.Movies + Stats.TvShows + Stats.Books + Stats.Albums + Stats.VideoGames + Stats.Playlists + Stats.Cars + Stats.Houses + Stats.Collectibles + Stats.Gear;

    /// <summary>
    /// Never paint over a page the user has already navigated to.
    /// <para>
    /// Blazor renders a component when its asynchronous initialisation completes, and this page's is a call to <c>/api/stats</c>: eleven counts, taking seconds under load.
    /// With enhanced navigation, a sidebar link clicked meanwhile swaps the DOM to the destination while this component is still mounted and loading.
    /// The completion render then puts the dashboard back over the destination, with the URL and the sidebar's active item still showing the destination.
    /// </para>
    /// <para>
    /// This guard alone isn't enough, since Blazor never calls <c>ShouldRender</c> for a first render, and the static-to-interactive handoff on circuit connect counts as one.
    /// A circuit connecting just before a sidebar click paints this page over the destination with <c>ShouldRender</c> never asked.
    /// The markup's <c>@if (IsStillTheCurrentPage)</c> wrapper closes that gap, applying to every render including the first.
    /// </para>
    /// </summary>
    protected override bool ShouldRender() => IsStillTheCurrentPage;

    /// <summary>
    /// Whether the browser is still on this page's own route.
    /// The circuit's <see cref="NavigationManager"/> learns of an enhanced navigation (it re-marks the sidebar's active item),
    /// so this reliably tells whether the page is still the one shown.
    /// </summary>
    private bool IsStillTheCurrentPage =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/').Length == 0;

    protected override async Task OnInitializedAsync()
    {
        // Stats already holds the prerendered data once [PersistentState] restores it on the interactive circuit, so no re-fetch.
        if (Stats is not null)
        {
            _loaded = true;
            return;
        }

        if (AuthenticationState is null)
        {
            _loaded = true;
            return;
        }

        var authState = await AuthenticationState;
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            _loaded = true;
            return;
        }

        await LoadingIndicator.RunAsync(FetchAsync(), v => _loading = v, StateHasChanged);
        _loading = false;
        _loaded = true;
    }

    private async Task FetchAsync()
    {
        try
        {
            Stats = await StatsApi.GetAsync();
        }
        catch (Exception)
        {
            // the greeting is decoration, and a stats hiccup must never break the landing page, so it falls back to the call-to-action variant
        }
    }
}
