@page "/not-found"
@attribute [ExcludeFromInteractiveRouting]
@layout MainLayout
@using Microsoft.AspNetCore.Diagnostics

@* Reached three ways, which is why this page keeps a real route of its own and renders statically:
   - an unknown URL on a full page load, re-executed onto this path by UseStatusCodePagesWithReExecute (Program.cs), so the path must be routable, and the original status is still on the response
   - an unknown URL followed inside a live circuit, rendered by the Router's NotFoundPage (Routes.razor), with no HttpContext at all
   - NavigationManager.NotFound(), for a route that matched but whose target doesn't exist
   [ExcludeFromInteractiveRouting] makes the first case readable: App.razor's RenderModeForPage checks for it, so this page renders statically with the cascaded HttpContext.
   A bogus URL (a stale bookmark, a crawler walking dead links) then never opens a SignalR circuit to say "no".
   No [Authorize]: a signed-out visitor following a dead link lands here rather than at login, which would reveal the page exists. *@

<PageTitle>@_heading - Keeptrack</PageTitle>

<div class="kt-empty kt-not-found">
    <div class="kt-empty-icon"><Icon Name="empty" Size="40" StrokeWidth="1.1"/></div>
    <div class="kt-not-found-code">Error @_statusCode</div>
    <h1>@_heading</h1>
    <p>@_message</p>
    <a class="btn btn-primary" href="/">Back to home</a>
</div>

@code {
    private const int FirstErrorStatusCode = 400;

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private int _statusCode = StatusCodes.Status404NotFound;
    private string _heading = "Page not found";
    private string _message = "This page doesn't exist, or the link that brought you here is out of date.";

    protected override void OnInitialized()
    {
        // The feature reports the original status whatever the re-executed pipeline does to the response afterwards.
        // Anything below 400 means the page was opened through its own /not-found route, or rendered by the Router with no request behind it, both meaning 404, never the 200 the response carries.
        var status = HttpContext?.Features.Get<IStatusCodeReExecuteFeature>()?.OriginalStatusCode
                     ?? HttpContext?.Response.StatusCode
                     ?? StatusCodes.Status404NotFound;
        _statusCode = status < FirstErrorStatusCode ? StatusCodes.Status404NotFound : status;

        // The middleware re-executes onto this path for every 400 to 599 with no body of its own, so the page must not claim "page not found" for a rejected antiforgery token.
        if (_statusCode != StatusCodes.Status404NotFound)
        {
            _heading = "Something went wrong";
            _message = "The server couldn't complete that request. Trying again, or starting over from the home page, usually clears it.";
        }
    }
}
