@inject ReferenceDataAdminApiClient Api

<AuthorizeView Policy="AdminOnly" Context="adminContext">
    <Authorized>
        @* No "not yet matched" line: this panel renders only after the title row's check-for-match came back without a link, which the toast beside that button already says. *@
        <div class="kt-form-card">
            @* only the domains with more than one registered provider return anything, so the picker shows for books and video games only *@
            @if (_providers.Count > 1)
            {
                <div class="d-flex gap-2 flex-wrap mb-2">
                    @foreach (var provider in _providers)
                    {
                        <button type="button" class="btn btn-sm @(provider.Key == _selectedProvider ? "btn-primary" : "btn-secondary")"
                                @onclick="() => _selectedProvider = provider.Key">@provider.DisplayName</button>
                    }
                </div>
            }

            @* One persistent button for search and re-search, relabelled rather than swapped, so it never looks like it vanished.
               It runs with the page's current title, year, author or artist, so wrong candidates are fixed by editing the fields above and searching again. *@
            <button class="btn btn-sm btn-secondary mb-2" @onclick="SearchAsync" disabled="@(_searching || string.IsNullOrWhiteSpace(Title))">
                @if (_searched) { <Icon Name="refresh" Size="13"/> <text> Search again</text> } else { <text>Search</text> }
            </button>

            @if (_searching)
            {
                <div class="kt-loading"><div class="kt-spinner"></div> Searching…</div>
            }
            else if (_searched && _results.Count == 0 && _error is null)
            {
                <div class="alert alert-info mb-2">No @ProviderName results for this title/year.</div>
            }
            else
            {
                @foreach (var candidate in _results)
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        @if (!string.IsNullOrEmpty(candidate.ImageUrl))
                        {
                            <img src="@candidate.ImageUrl" alt="@candidate.Title poster"
                                 style="width:40px;height:60px;object-fit:cover;flex-shrink:0" class="rounded"/>
                        }
                        <div>
                            <strong>@candidate.Title</strong> @(candidate.Year is not null ? $"({candidate.Year})" : "")
                            @if (!string.IsNullOrEmpty(candidate.Creator))
                            {
                                <div class="kt-card-meta">@candidate.Creator</div>
                            }
                            @if (candidate.TopCastNames.Count > 0)
                            {
                                <div class="kt-card-meta">@string.Join(", ", candidate.TopCastNames)</div>
                            }
                        </div>
                        <button class="btn btn-sm btn-success ms-auto" @onclick="() => LinkAsync(candidate)" disabled="@_linking">Link</button>
                    </div>
                }
            }

            @if (_error is not null)
            {
                <div class="alert alert-danger mt-2 mb-0">@_error</div>
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    [Parameter, EditorRequired] public required ReferenceItemType Type { get; set; }

    [Parameter, EditorRequired] public required string Title { get; set; }

    [Parameter] public int? Year { get; set; }

    /// <summary>
    /// The book's author or the album's artist, when known, which narrows the search, since a common title alone returns many unrelated candidates.
    /// TV shows, movies and video games ignore it.
    /// </summary>
    [Parameter] public string? Creator { get; set; }

    /// <summary>
    /// The book's ISBN, when known, for books only.
    /// Every book provider searches by it (see <see cref="IBookReferenceClient.SearchBooksAsync"/>), so switching provider is a real fallback rather than a silent downgrade to a title match.
    /// It is edited in <c>BookDetail.razor</c>'s own ISBN field, not here, like <see cref="Creator"/>.
    /// </summary>
    [Parameter] public string? Isbn { get; set; }

    [Parameter] public EventCallback OnLinked { get; set; }

    private bool _searched;
    private bool _searching;
    private bool _linking;
    private List<ReferenceSearchResultDto> _results = [];
    private string? _error;
    private List<ReferenceProviderDto> _providers = [];
    private string? _selectedProvider;

    private string ProviderName => _providers.FirstOrDefault(p => p.Key == _selectedProvider)?.DisplayName ?? Type switch
    {
        ReferenceItemType.TvShow or ReferenceItemType.Movie => "TMDB",
        ReferenceItemType.Album => "Discogs",
        _ => "reference"
    };

    protected override async Task OnInitializedAsync()
    {
        _providers = await Api.GetProvidersAsync(Type);
        _selectedProvider = _providers.FirstOrDefault(p => p.IsDefault)?.Key ?? _providers.FirstOrDefault()?.Key;
    }

    private async Task SearchAsync()
    {
        _searched = true;
        _searching = true;
        _error = null;
        try
        {
            _results = await Api.SearchAsync(Type, Title, Year, Creator, _selectedProvider, Type == ReferenceItemType.Book ? Isbn : null);
        }
        catch (Exception ex)
        {
            // An uncaught exception here would crash the whole Blazor Server circuit and force a full page reload, as in LinkAsync below.
            _results = [];
            _error = DescribeFailure("search", ex);
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task LinkAsync(ReferenceSearchResultDto candidate)
    {
        _linking = true;
        _error = null;
        try
        {
            await Api.LinkAsync(new LinkReferenceRequestDto
            {
                Type = Type,
                Title = Title,
                Year = Year,
                ExternalId = candidate.ExternalId,
                Provider = _selectedProvider,
                Isbn = Type == ReferenceItemType.Book ? Isbn : null,
                Creator = Type == ReferenceItemType.Album ? Creator : null
            });
            await OnLinked.InvokeAsync();
        }
        catch (Exception ex)
        {
            _error = DescribeFailure("link", ex);
        }
        finally
        {
            _linking = false;
        }
    }

    /// <summary>
    /// Names the provider, says what it actually did, and points at the way out.
    /// <para>
    /// <c>ApiRequestException</c> carries the API's own explanation, where the client's <c>ex.Message</c> would only give this API's 502 and make a provider outage read as a Keeptrack defect.
    /// </para>
    /// Another provider is suggested only when the failure was upstream and the domain has one: books and video games do, TV shows, movies and albums have a single provider each.
    /// Anything unidentified falls back to the plain retry hint, rather than sending an admin to a picker for a failure unrelated to the provider.
    /// </summary>
    private string DescribeFailure(string action, Exception ex)
    {
        var api = ex as ApiRequestException;
        var detail = api?.Message ?? "The request could not be completed.";
        var nextStep = api is { IsUpstreamProviderFailure: true } && _providers.Count > 1
            ? "Try one of the other providers above, or wait a moment and try again."
            : "This is usually transient - wait a moment and try again.";

        return $"{ProviderName} {action} failed. {detail} {nextStep}";
    }
}
