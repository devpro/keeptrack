    private async Task LoadUnresolvedAsync()
    {
        _unresolved = await Api.GetUnresolvedAsync(_type);
        _selected = null;
        _searchResults = [];
        _queryTitle = null;
        _queryYear = null;
        _creator = null;
        _isbn = null;
    }

    private async Task SelectTypeAsync(ReferenceItemType type)
    {
        _type = type;
        await LoadProvidersAsync();
        await LoadUnresolvedAsync();
    }

    /// <summary>
    /// Reloads the provider list for the selected domain, defaulting the selection to the first (registration
    /// order is priority order, so that is the deployment default).
    /// </summary>
    private async Task LoadProvidersAsync()
    {
        _providers = await Api.GetProvidersAsync(_type);
        _selectedProvider = _providers.FirstOrDefault()?.Key;
    }

    private async Task SelectItemAsync(UnresolvedReferenceDto item)
    {
        if (item == _selected)
        {
            _selected = null;
            return;
        }

        _selected = item;
        _queryTitle = item.Title;
        _queryYear = item.Year;
        _creator = item.Creator;
        _isbn = item.Isbn; // prefilled from one of the matching tenant items' own ISBN, same convenience as Creator
        await SearchAsync();
    }

    /// <summary>
    /// Searches the provider with the freely-editable query fields (prefilled from the selected unresolved
    /// entry, including a tenant's author/artist for Book/Album) rather than the stored title/year verbatim -
    /// a typo or regional title variant otherwise dead-ends with zero results and no way to adjust from this
    /// page. Edited values only steer the search; nothing here is ever saved back to any item.
    /// </summary>
    private async Task SearchAsync()
    {
        if (_selected is null) return;

        _searching = true;
        _error = null;
        try
        {
            _searchResults = await Api.SearchAsync(_type, _queryTitle ?? _selected.Title, _queryYear, _creator, _selectedProvider,
                _type == ReferenceItemType.Book ? _isbn : null);
        }
        catch (Exception ex)
        {
            // an uncaught exception here would crash the whole Blazor Server circuit (not just this
            // component), forcing a full page reload - same reasoning as LinkAsync's own try/catch below.
            _searchResults = [];
            _error = ex.Message;
        }
        finally
        {
            _searching = false;
        }
    }

    /// <summary>
    /// Deliberately links by the selected unresolved (title, year) pair, not the edited query fields - the
    /// query only helps *find* the right candidate; the alias that propagates to every tenant's matching item
    /// must stay the exact pair those items actually carry.
    /// </summary>
    private async Task LinkAsync(ReferenceSearchResultDto candidate)
    {
        if (_selected is null) return;

        _linking = true;
        _error = null;
        try
        {
            await Api.LinkAsync(new LinkReferenceRequestDto
            {
                Type = _type,
                Title = _selected.Title,
                Year = _selected.Year,
                ExternalId = candidate.ExternalId,
                Provider = _selectedProvider,
                Isbn = _type == ReferenceItemType.Book ? _isbn : null
            });
            await LoadUnresolvedAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _linking = false;
        }
    }

