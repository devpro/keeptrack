@* Cover thumbnail for an item row, shared by the inventory lists, Wishlist and Watch Next.
   The image and placeholder handling and the per-provider aspect ratios (see the .kt-item-thumb shape modifiers in app.css) exist once. *@

<div class="kt-item-thumb @Shape">
    @if (!string.IsNullOrEmpty(ImageUrl))
    {
        <img src="@ImageUrl" alt="" loading="lazy"/>
    }
    else
    {
        <CoverPlaceholder Title="@Title"/>
    }
</div>

@code {
    [Parameter] public string? ImageUrl { get; set; }

    /// <summary>The item's title, used only for the no-cover placeholder's initial.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Null or empty for portrait (default), "square" (albums), "wide" (video games).</summary>
    [Parameter] public string? Shape { get; set; }
}
