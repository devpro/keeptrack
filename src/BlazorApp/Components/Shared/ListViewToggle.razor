@using Keeptrack.BlazorApp.Components.Inventory
@inject ListViewPreference Preference
@inject IJSRuntime JS

@* The list/thumbnail segmented control, shared by every list page plus Wishlist and Watch Next.
   It owns the view preference: seeded once per circuit from localStorage, persisted on toggle, and reported through ViewChanged to the parent, which renders list or grid. *@

<div class="kt-view-toggle" role="group" aria-label="View mode">
    <button type="button" class="kt-view-btn @(View != "grid" ? "active" : "")"
            title="List view" aria-label="List view" @onclick='() => SetAsync("")'><Icon Name="view-list" Size="15"/></button>
    <button type="button" class="kt-view-btn @(View == "grid" ? "active" : "")"
            title="Thumbnail view" aria-label="Thumbnail view" @onclick='() => SetAsync("grid")'><Icon Name="view-grid" Size="15"/></button>
</div>

@code {
    /// <summary>Current view, "" for the detailed list and "grid" for poster thumbnails, owned by the parent.</summary>
    [Parameter] public string View { get; set; } = "";

    [Parameter] public EventCallback<string> ViewChanged { get; set; }

    // Seeds the shared preference from localStorage once per circuit, on the first interactive render, since the prerender can't reach localStorage.
    // Later pages read the seeded value synchronously, so only a session's first page can briefly show the default view.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Preference.Seeded)
        {
            return;
        }

        Preference.Seeded = true;
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", ListViewPreference.StorageKey);
            Preference.View = saved ?? "";
        }
        catch (JSException)
        {
            // localStorage unavailable (private-mode restrictions), so the default list view stays.
        }

        if (View != Preference.View)
        {
            await ViewChanged.InvokeAsync(Preference.View);
        }
    }

    private async Task SetAsync(string value)
    {
        Preference.View = value;
        Preference.Seeded = true;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ListViewPreference.StorageKey, value);
        }
        catch (JSException)
        {
            // localStorage unavailable, and the in-memory preference still carries the choice for the session.
        }

        await ViewChanged.InvokeAsync(value);
    }
}
