@page "/account/manage/shared/{ShareId}/cars/{Id}"
@using Keeptrack.BlazorApp.Components.Inventory.Pages
@attribute [Authorize(Policy = "MemberOnly")]

@* The recipient route for a shared car. Reuses the owner's own CarDetail page in read-only mode (ShareId set),
   which loads through the ownership-scoped /api/shared-with-me endpoints instead of the caller-scoped /api/cars. *@
<CarDetail ShareId="@ShareId" Id="@Id"/>

@code {
    [Parameter] public required string ShareId { get; set; }

    [Parameter] public required string Id { get; set; }
}
