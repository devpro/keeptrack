@* Standalone root for the anonymous shared-wishlist view (see SharedWishlistPage.razor),
   mapped to a route in Program.cs through RazorComponentResult, outside the globally interactive Router.
   It references no Blazor script, since this page must never open a SignalR circuit for an anonymous recipient. *@
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["Keeptrack.BlazorApp.styles.css"]"/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet/>
</head>

<body>
<SharedWishlistPage Token="@Token"/>
</body>

</html>

@code {
    [Parameter] public required string Token { get; set; }
}
